<view class="screen">
  <view class="pad" style="padding-top:24rpx">
    <!-- 用户头像区 -->
    <view class="user-hero" wx:if="{{isLoggedIn}}">
      <view class="uh-av">{{userInfo.username[0]}}</view>
      <text class="uh-name">{{userInfo.username}}</text>
      <text class="uh-role">{{userInfo.roles[0].name || '农户'}}</text>
    </view>
    <view class="user-hero user-guest" wx:else bindtap="goLogin">
      <view class="uh-av uh-guest-av">?</view>
      <text class="uh-name" style="color:var(--ink-3)">未登录</text>
      <text class="uh-role">点击登录</text>
    </view>

    <view class="spacer-lg"></view>

    <!-- 功能入口 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="goCalendar">
        <text class="mi-icon" style="color:var(--green)">C</text>
        <text class="mi-label">农事日历</text>
        <text class="mi-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goFeedback">
        <text class="mi-icon" style="color:var(--orange)">F</text>
        <text class="mi-label">我的反馈</text>
        <text class="mi-arrow">›</text>
      </view>
    </view>

    <view class="spacer"></view>

    <view class="menu-card" wx:if="{{isLoggedIn}}">
      <view class="menu-item" bindtap="logout">
        <text class="mi-icon" style="color:var(--red)">X</text>
        <text class="mi-label" style="color:var(--red)">退出登录</text>
      </view>
    </view>
  </view>
  <view class="spacer-lg"></view>
  <view class="spacer-lg"></view>
</view>
