.user-hero {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh);
  padding: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.uh-av { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--green); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 700; margin-bottom: 12rpx; }
.uh-guest-av { background: var(--divider); color: var(--ink-4); }
.uh-name { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.uh-role { font-size: 24rpx; color: var(--ink-4); margin-top: 4rpx; }
.menu-card { background: var(--card); border-radius: var(--r-lg); box-shadow: var(--sh); overflow: hidden; }
.menu-item { display: flex; align-items: center; gap: 16rpx; padding: 28rpx; border-bottom: 1rpx solid var(--divider); }
.menu-item:last-child { border-bottom: none; }
.mi-icon { font-size: 28rpx; font-weight: 700; width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; background: var(--bg); border-radius: 10rpx; flex-shrink: 0; }
.mi-label { flex: 1; font-size: 30rpx; font-weight: 500; color: var(--ink); }
.mi-arrow { font-size: 32rpx; color: var(--ink-4); }
