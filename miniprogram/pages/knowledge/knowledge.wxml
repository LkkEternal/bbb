<wxs src="../../utils/format.wxs" module="fmt" />
<view class="screen">
  <view class="pad" style="padding-top:24rpx">
    <text class="h2" style="display:block;margin-bottom:20rpx">知识库</text>

    <view class="kb-tabs">
      <view class="kb-tab {{activeTab === 'search' ? 'kb-on' : ''}}" bindtap="switchTab" data-tab="search">检索</view>
      <view class="kb-tab {{activeTab === 'qa' ? 'kb-on' : ''}}" bindtap="switchTab" data-tab="qa">问答</view>
    </view>

    <!-- 检索 -->
    <view wx:if="{{activeTab === 'search'}}">
      <view class="search-bar">
        <input class="sb-input" placeholder="输入病害名称" value="{{keyword}}" bindinput="onInput" bindconfirm="doSearch" />
        <view class="sb-btn" bindtap="doSearch">检索</view>
      </view>
      <view class="result-list" wx:if="{{searchResults.length > 0}}">
        <view class="result-card" wx:for="{{searchResults}}" wx:key="id">
          <text class="rc-title">{{item.documentTitle}}</text>
          <text class="rc-body">{{item.content}}</text>
          <view class="rc-score">
            <view class="rc-bar"><view class="rc-fill" style="width:{{item.score * 100}}%"></view></view>
            <text class="muted">{{fmt.pct(item.score)}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 问答 -->
    <view wx:if="{{activeTab === 'qa'}}">
      <view class="search-bar">
        <input class="sb-input" placeholder="描述您的问题" value="{{question}}" bindinput="onQuestionInput" bindconfirm="doAsk" />
        <view class="sb-btn" bindtap="doAsk">提问</view>
      </view>
      <view wx:if="{{qaResult}}" class="card" style="margin-top:16rpx">
        <text style="font-size:28rpx;font-weight:600;color:var(--green);display:block;margin-bottom:12rpx">Q: {{qaResult.question}}</text>
        <text style="font-size:28rpx;color:var(--ink-2);line-height:1.8;white-space:pre-wrap;display:block">{{qaResult.answer}}</text>
      </view>
    </view>

    <view wx:if="{{searching || asking}}" class="empty-state">
      <text class="empty-text">检索中...</text>
    </view>
  </view>
  <view class="spacer-lg"></view>
  <view class="spacer-lg"></view>
</view>
