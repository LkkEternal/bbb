<view class="screen">
  <view class="pad" style="padding-top:24rpx">
    <text class="h2" style="display:block;margin-bottom:20rpx">农事日历</text>

    <!-- 当前物候期 -->
    <view class="cal-hero" wx:if="{{current}}">
      <text class="ch-badge">当前</text>
      <text class="ch-name">{{current.name}}</text>
      <text class="ch-term">{{current.solarTerm}} · {{current.startDate}} ~ {{current.endDate}}</text>
      <view class="ch-line"></view>
      <text class="ch-pests">重点防治：{{current.focusPests}}</text>
    </view>

    <view class="spacer-lg"></view>

    <!-- 时间线 -->
    <view class="timeline">
      <view class="tl-row {{item.current ? 'tl-active' : ''}}" wx:for="{{periods}}" wx:key="id">
        <view class="tl-dots">
          <view class="tl-dot"></view>
          <view class="tl-line" wx:if="{{index < periods.length - 1}}"></view>
        </view>
        <view class="tl-card">
          <text class="tl-name">{{item.name}}</text>
          <text class="tl-meta">{{item.solarTerm}} · {{item.startDate}} ~ {{item.endDate}}</text>
          <text class="tl-pests">{{item.focusPests}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="spacer-lg"></view>
  <view class="spacer-lg"></view>
</view>
