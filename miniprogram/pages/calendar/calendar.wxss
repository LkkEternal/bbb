.cal-hero { background: var(--green); border-radius: var(--r-xl); padding: 36rpx; color: #fff; }
.ch-badge { font-size: 22rpx; background: rgba(255,255,255,0.2); display: inline-block; padding: 4rpx 14rpx; border-radius: 8rpx; font-weight: 600; }
.ch-name { font-size: 40rpx; font-weight: 800; display: block; margin: 12rpx 0 6rpx; }
.ch-term { font-size: 26rpx; opacity: 0.7; display: block; }
.ch-line { height: 1rpx; background: rgba(255,255,255,0.15); margin: 16rpx 0; }
.ch-pests { font-size: 26rpx; opacity: 0.85; display: block; }

.timeline { padding-left: 4rpx; }
.tl-row { display: flex; gap: 16rpx; padding-bottom: 16rpx; }
.tl-dots { display: flex; flex-direction: column; align-items: center; width: 24rpx; flex-shrink: 0; }
.tl-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--ink-4); }
.tl-active .tl-dot { background: var(--green); box-shadow: 0 0 0 6rpx rgba(58,125,68,0.12); }
.tl-line { width: 4rpx; flex: 1; background: var(--divider); margin-top: 4rpx; }
.tl-card { flex: 1; background: var(--card); border-radius: var(--r-md); padding: 20rpx; box-shadow: var(--sh); }
.tl-active .tl-card { border: 2rpx solid var(--green); background: var(--green-light); }
.tl-name { font-size: 28rpx; font-weight: 600; color: var(--ink); display: block; }
.tl-meta { font-size: 24rpx; color: var(--ink-4); display: block; margin-top: 4rpx; }
.tl-pests { font-size: 24rpx; color: var(--ink-3); display: block; margin-top: 6rpx; }
