<wxs src="../../utils/format.wxs" module="fmt" />
<view class="screen">
  <view class="pad" style="padding-top:24rpx">
    <text class="h2" style="display:block;margin-bottom:20rpx">我的反馈</text>
    <view class="fb-list">
      <view class="fb-card" wx:for="{{feedbacks}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="fb-top">
          <disease-tag code="{{item.aiDiagnosis === '溃疡病' ? 'S14' : item.aiDiagnosis === '炭疽病' ? 'S10' : 'S5'}}" />
          <view class="pill {{item.status === 0 ? 'pill-orange' : item.status === 3 ? 'pill-red' : 'pill-green'}}">
            {{item.status === 0 ? '待审核' : item.status === 1 ? '已采纳' : item.status === 2 ? '已修正' : '已驳回'}}
          </view>
        </view>
        <text class="fb-desc">{{item.description}}</text>
        <text class="fb-meta">{{item.orchardName}} · {{item.createdAt}}</text>
      </view>
    </view>
    <view wx:if="{{!loading && feedbacks.length === 0}}" class="empty-state">
      <text class="empty-text">暂无反馈记录</text>
    </view>
  </view>
  <view class="spacer-lg"></view>
  <view class="spacer-lg"></view>
</view>
