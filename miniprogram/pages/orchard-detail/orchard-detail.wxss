.detail-hero { position: relative; padding: 80rpx 32rpx 32rpx; overflow: hidden; }
.dh-bg { position: absolute; inset: 0; background: linear-gradient(165deg, #1B2820, #2A3D2E); }
.dh-content { position: relative; z-index: 1; }
.dh-name { font-size: 44rpx; font-weight: 800; color: #fff; display: block; }
.dh-addr { font-size: 26rpx; color: rgba(255,255,255,0.4); display: block; margin-top: 6rpx; margin-bottom: 28rpx; }
.dh-nums { display: flex; background: rgba(255,255,255,0.08); border-radius: var(--r-lg); padding: 24rpx 0; }
.dhn-item { flex: 1; text-align: center; }
.dhn-val { font-size: 40rpx; font-weight: 800; color: #fff; display: block; line-height: 1; }
.dhn-label { font-size: 22rpx; color: rgba(255,255,255,0.35); display: block; margin-top: 6rpx; }
.dhn-sep { width: 1rpx; background: rgba(255,255,255,0.1); }
.member-av { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--green-light); color: var(--green); display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
.dev-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
