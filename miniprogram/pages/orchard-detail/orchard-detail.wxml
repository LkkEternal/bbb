<view class="page" wx:if="{{orchard}}">
  <!-- Hero -->
  <view class="detail-hero">
    <view class="dh-bg"></view>
    <view class="dh-content">
      <text class="dh-name">{{orchard.name}}</text>
      <text class="dh-addr">{{orchard.formattedAddress}}</text>
      <view class="dh-nums">
        <view class="dhn-item">
          <text class="dhn-val">{{orchard.areaMu}}</text>
          <text class="dhn-label">亩</text>
        </view>
        <view class="dhn-sep"></view>
        <view class="dhn-item">
          <text class="dhn-val">{{orchard.treeAge}}</text>
          <text class="dhn-label">年树龄</text>
        </view>
        <view class="dhn-sep"></view>
        <view class="dhn-item">
          <text class="dhn-val">{{devices.length}}</text>
          <text class="dhn-label">设备</text>
        </view>
      </view>
    </view>
  </view>

  <view class="pad spacer-lg">
    <!-- 成员 -->
    <text class="h3" style="display:block;margin-bottom:16rpx">成员</text>
    <view class="card" style="padding:0;overflow:hidden">
      <view class="list-item" style="padding:20rpx 28rpx" wx:for="{{members}}" wx:key="userId">
        <view class="member-av">{{item.username[0]}}</view>
        <view style="flex:1">
          <text style="font-size:28rpx;font-weight:600;color:var(--ink);display:block">{{item.username}}</text>
          <text class="muted">{{item.roleType === 'owner' ? '园主' : item.roleType === 'manager' ? '管理员' : '查看者'}}</text>
        </view>
      </view>
    </view>

    <view class="spacer-lg"></view>

    <!-- 设备 -->
    <text class="h3" style="display:block;margin-bottom:16rpx">设备</text>
    <view class="card" style="padding:0;overflow:hidden">
      <view class="list-item" style="padding:20rpx 28rpx" wx:for="{{devices}}" wx:key="id">
        <view class="dev-dot" style="background:{{item.status ? 'var(--green)' : 'var(--ink-4)'}}"></view>
        <view style="flex:1">
          <text style="font-size:28rpx;font-weight:600;color:var(--ink);display:block">{{item.name}}</text>
          <text class="muted">{{item.type === 'camera' ? '摄像头' : '传感器'}} · {{item.lastHeartbeat || '无心跳'}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="spacer-lg"></view>
  <view class="spacer-lg"></view>
</view>
