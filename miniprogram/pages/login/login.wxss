.login-screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* === 品牌区 === */
.login-brand {
  position: relative;
  padding: 100rpx 40rpx 60rpx;
  background: var(--green);
  overflow: hidden;
}

.brand-pattern {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.brand-pattern::after {
  content: '';
  position: absolute;
  top: 80rpx;
  right: -100rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}

.brand-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
}

.brand-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 3rpx;
}

.brand-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* === 表单区 === */
.login-form {
  flex: 1;
  padding: 40rpx 40rpx 0;
  margin-top: -20rpx;
  background: var(--bg);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
}

.lf-tabs {
  display: flex;
  background: var(--divider);
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
}

.lft {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink-3);
  border-radius: 10rpx;
}

.lft-on {
  background: var(--card);
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.lf-field {
  margin-bottom: 28rpx;
}

.lf-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
  display: block;
  margin-bottom: 10rpx;
}

.lf-row {
  display: flex;
  gap: 16rpx;
}

.lf-input {
  width: 100%;
  height: 96rpx;
  background: var(--card);
  border: 1rpx solid var(--divider);
  border-radius: var(--r-md);
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.lf-input:focus {
  border-color: var(--green);
}

.lf-grow {
  flex: 1;
}

.lf-sms {
  flex-shrink: 0;
  height: 96rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-light);
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--green);
  font-weight: 600;
}

.lf-sms-off {
  opacity: 0.4;
}

.lf-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--green) !important;
  color: #fff !important;
  border: none !important;
  border-radius: var(--r-md);
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-top: 12rpx;
}

.lf-btn::after {
  border: none;
}

/* === 体验入口 === */
.lf-demo {
  margin-top: 32rpx;
  text-align: center;
  padding: 20rpx 0;
}

.demo-text {
  font-size: 28rpx;
  color: var(--ink-4);
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
