<view class="login-screen">
  <!-- 顶部品牌区 -->
  <view class="login-brand">
    <view class="brand-pattern"></view>
    <view class="brand-content">
      <image class="brand-logo" src="/images/logo-sm.png" mode="aspectFit" />
      <text class="brand-title">脐橙病虫害监测</text>
      <text class="brand-sub">智能守护每一棵脐橙树</text>
    </view>
  </view>

  <!-- 表单区 -->
  <view class="login-form">
    <view class="lf-tabs">
      <view class="lft {{loginType === 'password' ? 'lft-on' : ''}}" bindtap="switchType" data-type="password">密码登录</view>
      <view class="lft {{loginType === 'sms' ? 'lft-on' : ''}}" bindtap="switchType" data-type="sms">验证码登录</view>
    </view>

    <view class="lf-field">
      <text class="lf-label">手机号</text>
      <input class="lf-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="lf-field" wx:if="{{loginType === 'password'}}">
      <text class="lf-label">密码</text>
      <input class="lf-input" placeholder="请输入密码" password value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <view class="lf-field" wx:if="{{loginType === 'sms'}}">
      <text class="lf-label">验证码</text>
      <view class="lf-row">
        <input class="lf-input lf-grow" placeholder="请输入验证码" type="number" maxlength="6" value="{{smsCode}}" bindinput="onSmsInput" />
        <view class="lf-sms {{cooldown > 0 ? 'lf-sms-off' : ''}}" bindtap="sendSms">
          {{cooldown > 0 ? cooldown + 's' : '获取验证码'}}
        </view>
      </view>
    </view>

    <button class="lf-btn" bindtap="doLogin" loading="{{loading}}">登录</button>

    <!-- 体验入口 -->
    <view class="lf-demo" bindtap="skipLogin">
      <text class="demo-text">跳过登录，进入体验模式</text>
    </view>
  </view>
</view>
