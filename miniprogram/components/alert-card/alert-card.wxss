.alert-card {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FAFAFA;
  margin-bottom: 16rpx;
}
.alert-card.unread { background: #FFF8F0; }
.level-bar { width: 6rpx; height: 52rpx; border-radius: 3rpx; flex-shrink: 0; }
.alert-body { flex: 1; margin: 0 20rpx; min-width: 0; }
.alert-title { font-size: 28rpx; font-weight: 500; color: #1A1C1E; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.alert-meta { font-size: 24rpx; color: #9AA0A6; margin-top: 4rpx; }
.level-tag { font-size: 22rpx; font-weight: 500; border: 1rpx solid; border-radius: 10rpx; padding: 4rpx 12rpx; flex-shrink: 0; line-height: 1.2; }
