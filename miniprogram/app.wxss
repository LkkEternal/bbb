/* === 脐橙监测小程序 — 农户端独立设计系统 ===
   设计理念：农户视角、一眼可读、触手可及
   核心原则：大字体、大间距、大触控区、状态优先
*/

page {
  /* 色彩 */
  --green: #3A7D44;
  --green-light: #E8F5E9;
  --green-dark: #2E6B38;
  --orange: #E8863A;
  --orange-light: #FFF3E8;
  --red: #D64545;
  --red-light: #FFEBEE;
  --yellow: #D4A853;
  --yellow-light: #FFF9E8;

  /* 文字 */
  --ink: #1A1C1E;
  --ink-2: #4A4E52;
  --ink-3: #8A8E92;
  --ink-4: #B0B4B8;

  /* 表面 */
  --bg: #F4F6F1;
  --card: #FFFFFF;
  --divider: #EBEDE8;

  /* 圆角 */
  --r-sm: 12rpx;
  --r-md: 20rpx;
  --r-lg: 28rpx;
  --r-xl: 40rpx;

  /* 阴影 */
  --sh: 0 4rpx 16rpx rgba(0,0,0,0.05);

  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 30rpx;
  color: var(--ink);
  background: var(--bg);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* === 布局 === */
.screen { min-height: 100vh; padding-bottom: env(safe-area-inset-bottom); }
.pad { padding: 0 32rpx; }
.spacer { height: 24rpx; }
.spacer-lg { height: 48rpx; }

/* === 卡片 === */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--sh);
  padding: 28rpx;
}

/* === 按钮 === */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  border-radius: var(--r-lg);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  letter-spacing: 2rpx;
}
.btn::after { border: none; }
.btn-green {
  background: var(--green);
  color: #fff;
}
.btn-green-ghost {
  background: var(--green-light);
  color: var(--green);
}

/* === 标签 === */
.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.pill-green { background: var(--green-light); color: var(--green); }
.pill-orange { background: var(--orange-light); color: var(--orange); }
.pill-red { background: var(--red-light); color: var(--red); }
.pill-yellow { background: var(--yellow-light); color: var(--yellow); }

/* === 文字 === */
.h1 { font-size: 48rpx; font-weight: 800; color: var(--ink); line-height: 1.2; }
.h2 { font-size: 36rpx; font-weight: 700; color: var(--ink); line-height: 1.3; }
.h3 { font-size: 32rpx; font-weight: 600; color: var(--ink); }
.body { font-size: 30rpx; color: var(--ink-2); line-height: 1.6; }
.caption { font-size: 26rpx; color: var(--ink-3); }
.muted { font-size: 24rpx; color: var(--ink-4); }
.big-num { font-size: 64rpx; font-weight: 800; color: var(--ink); line-height: 1; letter-spacing: -2rpx; }
.num { font-size: 44rpx; font-weight: 700; color: var(--ink); line-height: 1; }

/* === 列表项 === */
.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.list-item:last-child { border-bottom: none; }

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty-state .empty-icon { font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.3; }
.empty-state .empty-text { font-size: 28rpx; color: var(--ink-4); }
