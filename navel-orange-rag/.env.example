# ── 服务基础 ──
HOST=0.0.0.0
PORT=18001
LOG_LEVEL=info

# ── Embedding（bge-small-zh-v1.5） ──
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=auto      # cpu | cuda | auto

# ── LLM: DeepSeek API（可选，qwen-local 不可用时自动降级） ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── LLM: 本地 Qwen3-32B（MindIE 推理框架，昇腾 910B NPU） ──
QWEN_LOCAL_BASE_URL=https://10.168.89.186:5443/open/router/v1
QWEN_LOCAL_MODEL=qwen3-32b-user
QWEN_LOCAL_TIMEOUT=120
QWEN_LOCAL_API_KEY=ME-sk-ZtsDePRbkExKhLnv7I+DtQ==-ot85ZPQLS1h37vz7kXLZgHlnHVB7WlcI

# ── LLM 默认选择 ──
LLM_DEFAULT_MODEL=qwen-local   # deepseek | qwen-local

# ── 文档处理 ──
TEMP_DIR=/tmp/navel-orange-rag
