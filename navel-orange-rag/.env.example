# ── 服务基础 ──
HOST=0.0.0.0
PORT=18001
LOG_LEVEL=info

# ── Embedding（bge-small-zh-v1.5） ──
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=auto      # cpu | cuda | auto

# ── LLM: DeepSeek API ──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── LLM: 本地 Qwen3-32B（vLLM/Ollama） ──
QWEN_LOCAL_BASE_URL=http://localhost:8000/v1
QWEN_LOCAL_MODEL=Qwen3-32B

# ── LLM 默认选择 ──
LLM_DEFAULT_MODEL=qwen-local   # deepseek | qwen-local

# ── 文档处理 ──
TEMP_DIR=/tmp/navel-orange-rag
