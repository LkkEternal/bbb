# ============================================================
# 表情检测系统 - 环境变量配置模板
# ============================================================
# 使用说明:
#   1. 复制此文件为 .env
#   2. 根据实际情况修改配置项
#   3. 不要将 .env 文件提交到Git仓库
# ============================================================

# ============================================================
# 服务配置
# ============================================================

# Python服务配置
PYTHON_SERVICE_HOST=0.0.0.0
PYTHON_SERVICE_PORT=8001

# Java服务配置
JAVA_SERVICE_HOST=0.0.0.0
JAVA_SERVICE_PORT=8080

# 前端配置
VITE_API_BASE_URL=http://localhost:8080

# ============================================================
# YOLO模型配置
# ============================================================

# 模型路径（8类表情分类模型：7种表情 + unknown）
YOLO_MODEL_PATH=models/yolov8_emotion_8class.pt

# 设备配置（0=GPU, cpu=CPU）
YOLO_DEVICE=0

# ============================================================
# 知识库配置
# ============================================================

# 知识库目录
KNOWLEDGE_DIR=data/knowledge
VECTOR_DIR=data/vectors

# 检索配置
RETRIEVAL_TOP_K=3
RETRIEVAL_SIMILARITY_THRESHOLD=0.5

# ============================================================
# Embedding配置
# ============================================================

# Embedding模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_DEVICE=auto

# ============================================================
# LLM配置
# ============================================================

# 默认LLM提供商 (deepseek/qwen_local)
DEFAULT_LLM_PROVIDER=deepseek

# DeepSeek API配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Qwen本地配置
QWEN_MODEL_PATH=Qwen/Qwen-7B-Chat
QWEN_DEVICE=auto
QWEN_MAX_LENGTH=2048

# LLM生成参数
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024

# ============================================================
# 数据集配置
# ============================================================

# FER2013数据集
DATASET_CSV_PATH=data/raw/fer2013.csv
DATASET_YOLO_PATH=data/processed/fer2013_yolo

# 训练配置
TRAIN_EPOCHS=100
TRAIN_BATCH_SIZE=16
TRAIN_IMG_SIZE=640
TRAIN_DEVICE=0

# ============================================================
# 日志配置
# ============================================================

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# ============================================================
# 开发配置
# ============================================================

# 开发模式
DEBUG=true

# CORS配置
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
