/* orchard-detail.wxss - 果园详情页样式 */

.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(70px + env(safe-area-inset-bottom));
}

/* 顶部导航栏 */
.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  color: #fff;
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.nav-edit {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
}

/* 果园信息卡片 */
.info-card {
  margin: 25rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.orchard-name {
  display: block;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.orchard-address {
  display: block;
  font-size: var(--font-body);
  color: var(--text-secondary);
  margin-bottom: 25rpx;
}

.info-row {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  margin-bottom: 6rpx;
}

.info-value {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

/* 通用区域标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.section-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.section-sub {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.section-more {
  font-size: var(--font-body);
  color: var(--primary-color);
}

/* 成员信息卡片 */
.member-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: var(--radius-small);
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  background: var(--primary-light);
  border-radius: var(--radius-circle);
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.member-name {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
}

.member-phone {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.member-role-tag {
  padding: 6rpx 18rpx;
  border-radius: var(--radius-circle);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.member-role-tag.owner {
  background: rgba(0, 180, 42, 0.1);
  color: #00b42a;
}

.member-role-tag.manager {
  background: rgba(255, 125, 0, 0.1);
  color: #ff7d00;
}

.member-role-tag.viewer {
  background: rgba(134, 144, 156, 0.1);
  color: #86909c;
}

/* 设备管理卡片 */
.device-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: var(--radius-small);
}

.device-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #e8f5e9;
  border-radius: var(--radius-circle);
  margin-right: 20rpx;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.device-name {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.device-type {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.device-status {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-circle);
  font-size: var(--font-small);
  font-weight: 500;
}

.device-status.online {
  background: rgba(0, 180, 42, 0.1);
  color: #00b42a;
}

.device-status.offline {
  background: rgba(245, 63, 63, 0.1);
  color: #f53f3f;
}

.device-monitor-btn {
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: var(--primary-color, #07c160);
  color: #fff;
  white-space: nowrap;
  flex-shrink: 0;
}

.device-monitor-btn:active {
  opacity: 0.8;
}

/* 识别统计卡片 */
.detection-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.stats-overview {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stat-value.alert {
  color: var(--danger-color);
}

.stat-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.sub-title {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

/* 病害分布 */
.disease-distribution {
  margin-bottom: 30rpx;
}

.pie-chart {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pie-visual {
  width: 200rpx;
  height: 200rpx;
}

.pie-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  background: #f0f0f0;
}

.pie-slice {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-origin: 50% 50%;
}

.pie-legend {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.legend-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.legend-count {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-right: 10rpx;
}

.legend-percent {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
  width: 80rpx;
  text-align: right;
}

/* 识别记录 */
.detection-records {
  margin-top: 20rpx;
}

.detection-item {
  display: flex;
  padding: 20rpx;
  background: #fafafa;
  border-radius: var(--radius-small);
  margin-bottom: 16rpx;
}

.detection-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-small);
  margin-right: 20rpx;
  background: #f0f0f0;
}

.detection-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.detection-info .disease-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.detection-info .confidence {
  font-size: 24rpx;
  color: #ff7d00;
}

.detection-info .device-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.detection-info .detection-time {
  font-size: 22rpx;
  color: var(--text-auxiliary);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0;
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 500;
  background: #f5f5f5;
  border-radius: var(--radius-small);
  margin-top: 16rpx;
}

.load-more:active {
  background: #e8e8e8;
}

/* 病害历史卡片 */
.detection-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.detection-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detection-item {
  display: flex;
  padding: 20rpx;
  background: #fafafa;
  border-radius: var(--radius-small);
}

.detection-thumb {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  background: #f0f0f0;
  border-radius: var(--radius-small);
  margin-right: 20rpx;
}

.detection-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.detection-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.detection-name {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
}

.detection-confidence {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--danger-color);
}

.detection-meta {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-auxiliary);
  font-size: var(--font-body);
}