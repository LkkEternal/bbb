<view class="container">
  <!-- ===== 顶部导航栏 ===== -->
  <view class="top-navbar">
    <view class="nav-back" bindtap="goBack">
      <van-icon name="arrow-left" size="36" color="#fff" />
    </view>
    <text class="nav-title">提交反馈</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- ===== 表单内容 ===== -->
  <view class="form-container">

    <!-- 果园选择 -->
    <picker mode="selector"
            range="{{orchardList}}"
            range-key="name"
            value="{{orchardIndex}}"
            bindchange="onOrchardChange"
            disabled="{{orchardList.length === 0}}">
      <view class="form-item">
        <text class="form-label">果园 <text class="required">*</text></text>
        <view class="form-value-wrap">
          <text class="form-value {{orchardIndex < 0 ? 'placeholder' : ''}}">{{orchardText}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>

    <!-- 反馈类型 -->
    <view class="form-item" bindtap="onTypeTap">
      <text class="form-label">反馈类型 <text class="required">*</text></text>
      <view class="form-value-wrap">
        <text class="form-value">{{feedbackTypeText}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <!-- 图片上传（单张，上传至 OBS） -->
    <view class="form-item form-item-upload">
      <text class="form-label">上传图片 <text class="required">*</text></text>
      <text class="form-tip">最多1张，点击可预览</text>
      <view class="image-section">
        <view wx:if="{{image}}" class="image-item">
          <image src="{{image}}" mode="aspectFill" class="image-preview" bindtap="previewImage" />
          <view class="image-remove" bindtap="removeImage">
            <text class="remove-icon">×</text>
          </view>
        </view>
        <view wx:else class="image-add" bindtap="chooseImage">
          <text class="add-icon">+</text>
          <text class="add-text">上传图片</text>
        </view>
      </view>
    </view>

    <!-- 问题描述 -->
    <view class="form-item form-item-textarea">
      <text class="form-label">问题描述</text>
      <textarea class="form-textarea"
                value="{{description}}"
                bindinput="onDescriptionInput"
                placeholder="请描述您遇到的问题..."
                maxlength="500"
                auto-height />
      <text class="char-count">{{description.length}}/500</text>
    </view>
  </view>

  <!-- ===== 提交按钮 ===== -->
  <view class="submit-wrap">
    <button class="submit-btn"
            bindtap="submitFeedback"
            disabled="{{submitting}}"
            loading="{{submitting}}">
      {{submitting ? '提交中...' : '提交反馈'}}
    </button>
  </view>
</view>
