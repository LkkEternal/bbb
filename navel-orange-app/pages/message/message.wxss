.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  align-items: center;
}

.nav-left,
.nav-right {
  width: 60rpx;
  flex-shrink: 0;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.stats-bar {
  margin: 20rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 24rpx 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #f0f0f0;
}

.mark-all {
  padding: 12rpx 24rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-auxiliary);
  border-radius: var(--radius-button);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.filter-bar {
  margin: 0 30rpx 20rpx;
  display: flex;
  gap: 16rpx;
}

.filter-tab {
  padding: 12rpx 32rpx;
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  background: #f5f5f5;
  border-radius: var(--radius-button);
}

.filter-tab.active {
  background: var(--primary-color);
  color: #fff;
  font-weight: 600;
}

.list-container {
  height: calc(100vh - 290rpx);
  padding: 0 30rpx;
  box-sizing: border-box;
}

.msg-item {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.msg-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.msg-indicator.high {
  background: var(--danger-color);
}

.msg-indicator.medium {
  background: var(--warning-color);
}

.msg-indicator.low {
  background: var(--low-risk-color);
}

.msg-content {
  flex: 1;
  min-width: 0;
}

.msg-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.msg-title {
  font-size: var(--font-body);
  color: var(--text-primary);
  flex: 1;
}

.msg-title.unread {
  font-weight: 600;
}

.unread-dot {
  font-size: 20rpx;
  color: var(--danger-color);
  margin-left: 8rpx;
  flex-shrink: 0;
}

.msg-summary {
  font-size: var(--font-auxiliary);
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.msg-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-auxiliary);
  color: var(--text-disabled);
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
  margin-right: 12rpx;
}

.status-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: var(--font-small);
  font-weight: 500;
  line-height: 1.6;
}

.status-tag.unread {
  background: #FFECE8;
  color: #F53F3F;
}

.status-tag.read {
  background: #E8F8E8;
  color: #00B42A;
}

.load-more-hint {
  text-align: center;
  padding: 30rpx 0;
  font-size: var(--font-auxiliary);
  color: var(--text-disabled);
}

.empty-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-icon {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: center;
}

.empty-text {
  font-size: var(--font-body);
  color: var(--text-auxiliary);
}