.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  align-items: center;
}

.nav-left,
.nav-right {
  width: 60rpx;
  flex-shrink: 0;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.stats-bar {
  margin: 20rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 24rpx 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #f0f0f0;
}

.mark-all {
  padding: 12rpx 24rpx;
  background: var(--primary-color);
  color: #fff;
  font-size: var(--font-auxiliary);
  border-radius: var(--radius-button);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.filter-bar {
  margin: 16rpx 30rpx;
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx;
  border-radius: 10rpx;
  gap: 2rpx;
}

.filter-option.active {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
}

.filter-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.filter-option.active .filter-label {
  color: #fff;
}

.filter-count {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.filter-option.active .filter-count {
  color: rgba(255,255,255,0.9);
}

.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  position: relative;
}

.tab-label {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

.tab-item.active .tab-label {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}

.detection-item {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.detection-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #ccc;
}
.detection-indicator.high { background: #E53935; }
.detection-indicator.medium { background: #FA8C16; }
.detection-indicator.low { background: #3D8B40; }

.detection-level-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
  flex-shrink: 0;
}
.detection-level-tag.high { background: #E53935; }
.detection-level-tag.medium { background: #FA8C16; }
.detection-level-tag.low { background: #3D8B40; }

.detection-email-status {
  font-size: 22rpx;
  color: #00B42A;
  margin-top: 4rpx;
}

.detection-processed {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 500;
}
.detection-processed.done {
  background: #E8F8E8;
  color: #00B42A;
}
.detection-processed.pending {
  background: #FFF7E6;
  color: #FA8C16;
}


.detection-content {
  flex: 1;
  min-width: 0;
}

.detection-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.detection-name {
  font-size: var(--font-body);
  color: var(--text-primary);
  flex: 1;
}

.detection-conf {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.detection-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-auxiliary);
  color: var(--text-disabled);
}

.detection-meta.orchard {
  color: var(--primary-color);
}

.detection-time {
  font-size: var(--font-auxiliary);
  color: var(--text-disabled);
}

.list-container {
  height: calc(100vh - 290rpx);
  padding: 0 30rpx;
  box-sizing: border-box;
}

.msg-item {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.msg-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.msg-indicator.high {
  background: var(--danger-color);
}

.msg-indicator.medium {
  background: var(--warning-color);
}

.msg-indicator.low {
  background: var(--low-risk-color);
}

.msg-content {
  flex: 1;
  min-width: 0;
}

.msg-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.msg-title {
  font-size: var(--font-body);
  color: var(--text-primary);
  flex: 1;
}

.msg-title.unread {
  font-weight: 600;
}

.msg-orchard-name {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-bottom: 6rpx;
}

.unread-dot {
  font-size: 20rpx;
  color: var(--danger-color);
  margin-left: 8rpx;
  flex-shrink: 0;
}

.msg-summary {
  font-size: var(--font-auxiliary);
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.msg-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--font-auxiliary);
  color: var(--text-disabled);
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
  margin-right: 12rpx;
}

.status-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: var(--font-small);
  font-weight: 500;
  line-height: 1.6;
}

.status-tag.unread {
  background: #FFECE8;
  color: #F53F3F;
}

.status-tag.read {
  background: #E8F8E8;
  color: #00B42A;
}

.load-more-hint {
  text-align: center;
  padding: 30rpx 0;
  font-size: var(--font-auxiliary);
  color: var(--text-disabled);
}

.empty-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-icon {
  margin-bottom: 20rpx;
  display: flex;
  justify-content: center;
}

.empty-text {
  font-size: var(--font-body);
  color: var(--text-auxiliary);
}

.msg-processed-badge {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.msg-processed-badge.done {
  background: #E8F8E8;
  color: #00B42A;
}
.msg-processed-badge.pending {
  background: #FFF7E6;
  color: #FA8C16;
}