<view class="page-container">
  <view class="top-navbar">
    <text class="nav-title">首页看板</text>
  </view>

  <view class="orchard-selector" bindtap="showOrchardPicker">
    <view class="selector-content">
      <van-icon name="location-o" size="36" color="var(--primary-color)" class="selector-icon" />
      <text class="selector-text">{{currentOrchard || '选择果园'}}</text>
    </view>
    <van-icon name="arrow-down" size="24" color="var(--text-auxiliary)" class="selector-arrow" />
  </view>

  <view wx:if="{{orchardList.length === 0 && noOrchardTip}}" class="no-orchard-tip">
    <text>{{noOrchardTip}}</text>
  </view>

  <view wx:if="{{hasL3Alert}}" class="alert-banner" bindtap="goToAlerts">
    <van-icon name="warning" size="28" color="#cf1322" /> 存在高风险预警，请立即查看 →
  </view>

  <!-- ===== 1. 当前提醒卡片 ===== -->
  <view wx:if="{{currentReminder}}" class="reminder-card">
    <view class="section-header">
      <van-icon name="calendar-o" size="28" color="var(--primary-color)" />
      <text class="section-title">当前提醒</text>
    </view>

    <!-- 当前物候 -->
    <view class="reminder-phenology">
      <van-icon name="flower-o" size="28" color="#666" />
      <view class="phenology-info">
        <text class="phenology-name">{{currentReminder.phenologyName}}</text>
        <text class="phenology-meta">{{currentReminder.solarTerm}} · {{currentReminder.period}}</text>
      </view>
    </view>

    <!-- 农事建议 -->
    <view wx:if="{{currentReminder.adviceContent}}" class="reminder-section">
      <view class="reminder-section-title-row"><van-icon name="info-o" size="24" color="#666" /><text class="reminder-section-title">农事建议</text></view>
      <text class="reminder-text">{{currentReminder.adviceContent}}</text>
    </view>

    <!-- 关联病害 -->
    <view wx:if="{{currentReminder.diseaseRelated && currentReminder.diseaseRelated.length > 0}}" class="reminder-section">
      <view class="reminder-section-title-row"><van-icon name="warning-o" size="24" color="#666" /><text class="reminder-section-title">关联病害</text></view>
      <view class="disease-tags">
        <text wx:for="{{currentReminder.diseaseRelated}}" wx:key="diseaseCode" class="disease-tag">{{item.diseaseName}}</text>
      </view>
    </view>

    <!-- 下个物候 -->
    <view wx:if="{{upcomingReminder}}" class="reminder-upcoming">
      <van-icon name="clock" size="24" color="#666" />
      <text class="upcoming-label">下个物候</text>
      <text class="upcoming-text">{{upcomingReminder.phenologyName}}（还有{{upcomingReminder.daysLeft}}天）</text>
    </view>
  </view>

  <!-- ===== 3. 本周天气趋势卡片 ===== -->
  <view wx:if="{{hasEnvData}}" class="env-card">
    <view class="section-header">
      <van-icon name="chart-trending-o" size="28" color="#07c160" />
      <text class="section-title">本周天气趋势</text>
    </view>
    <ec-canvas id="trend-chart" canvas-id="trendCanvas" ec="{{ ec }}" style="height: 500rpx; display: block;"></ec-canvas>
  </view>

  <!-- ===== 4. 预警提醒卡片 ===== -->
  <view wx:if="{{recentAlerts.length > 0}}" class="alert-card">
    <view class="section-header">
      <van-icon name="bell" size="28" color="#E53935" />
      <text class="section-title">待处理预警</text>
    </view>
    <view wx:for="{{recentAlerts}}" wx:key="id" class="alert-item" bindtap="goToAlertDetail" data-id="{{item.id}}">
      <view class="alert-left">
        <view class="alert-dot {{item.levelClass}}"></view>
      </view>
      <view class="alert-right">
        <view class="alert-title-row">
          <text class="alert-title">{{item.title}}</text>
          <text class="alert-level-tag {{item.levelClass}}">{{item.levelLabel}}</text>
        </view>
        <view class="alert-meta-row">
          <text wx:if="{{item.orchardName}}" class="alert-meta">{{item.orchardName}}</text>
          <text class="alert-meta">{{item.time}}</text>
          <text class="alert-meta">{{item.processed ? '已处理' : '未处理'}}</text>
        </view>
        <view wx:if="{{item.pushEmailStatus === 'sent'}}" class="alert-email-status">
          <van-icon name="passed" size="20" color="#00B42A" />
          <text>已邮件通知</text>
        </view>
      </view>
    </view>
    <view class="view-all-wrap" bindtap="goToAlerts">
      <text class="view-all-text">查看全部</text>
      <van-icon name="arrow" size="20" color="#07c160" />
    </view>
  </view>

  <!-- ===== 4. 病害分布+最近检测卡片 ===== -->
  <view wx:if="{{diseaseRanking.length > 0 || diseaseHistory.length > 0}}" class="disease-card">
    <view wx:if="{{diseaseRanking.length > 0}}">
      <view class="section-header">
        <text class="section-title">今日病害分布</text>
      </view>
      <view class="disease-list">
        <view wx:for="{{diseaseRanking}}" wx:key="name" class="disease-item">
          <text class="disease-name">{{item.name}}</text>
          <view class="disease-bar-track">
            <view class="disease-bar-fill" style="width: {{item.barWidth}}%"></view>
          </view>
          <view class="disease-meta">
            <text class="disease-percent">{{item.percent}}%</text>
            <text class="disease-count">{{item.count}}次</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{diseaseHistory.length > 0}}" class="recent-detections">
      <view class="detections-title">最近检测</view>
      <view wx:for="{{diseaseHistory}}" wx:key="index" class="detection-item">
        <van-icon name="flower-o" size="24" color="var(--text-auxiliary)" class="detection-icon" />
        <text class="detection-name {{item.riskClass}}">{{item.diseaseName}}</text>
        <text class="detection-prob">{{item.probabilityPercent}}%</text>
        <text class="detection-time">{{item.detectedAt}}</text>
      </view>
      <view class="view-all-wrap" bindtap="goToDetections">
        <text class="view-all-text">查看全部检测</text>
        <van-icon name="arrow" size="20" color="#07c160" />
      </view>
    </view>
  </view>

  <custom-tabbar current-page="/pages/index/index"></custom-tabbar>
</view>
