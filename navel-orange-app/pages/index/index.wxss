.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(70px + env(safe-area-inset-bottom));
}

.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.nav-right {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.notification-icon {
  display: flex;
  align-items: center;
}

.notification-badge {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--danger-color);
  border-radius: var(--radius-circle);
  font-size: var(--font-small);
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 8rpx;
}

.orchard-selector {
  margin: 20rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-button);
  padding: 25rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.selector-content {
  display: flex;
  align-items: center;
}

.selector-icon {
  margin-right: 15rpx;
  display: flex;
  align-items: center;
}

.selector-text {
  font-size: var(--font-body);
  color: var(--text-primary);
}

.selector-arrow {
  display: flex;
  align-items: center;
  color: var(--text-auxiliary);
}

.no-orchard-tip {
  text-align: center;
  padding: 40rpx 30rpx;
  color: var(--text-auxiliary);
  font-size: var(--font-body);
  background: var(--card-bg);
  margin: 0 30rpx 25rpx;
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.risk-card {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 2rpx solid rgba(250, 140, 22, 0.3);
}

.risk-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.risk-level-tag {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-button);
}

.risk-level-tag.low {
  background: #E8F8E8;
  color: #00B42A;
}

.risk-level-tag.medium {
  background: #FFF7E6;
  color: #FF7D00;
}

.risk-level-tag.high {
  background: #FFECE8;
  color: #F53F3F;
}

.risk-tag-icon {
  margin-right: 10rpx;
  display: flex;
  align-items: center;
}

.risk-tag-text {
  font-size: 34rpx;
  font-weight: 700;
}

.risk-score-box {
  display: flex;
  align-items: baseline;
}

.risk-score-num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.risk-score-den {
  font-size: var(--font-auxiliary);
  color: var(--text-disabled);
  margin-left: 4rpx;
}

.risk-bar {
  margin-bottom: 24rpx;
}

.risk-bar-track {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.risk-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.risk-bar-fill.low {
  background: linear-gradient(90deg, #52C41A, #73D13D);
}

.risk-bar-fill.medium {
  background: linear-gradient(90deg, #FFA940, #FF7D00);
}

.risk-bar-fill.high {
  background: linear-gradient(90deg, #FF4d4f, #F53F3F);
}

.risk-metrics {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.risk-metric {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.metric-icon {
  display: flex;
  align-items: center;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.metric-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.risk-desc {
  display: block;
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  line-height: 1.5;
}

.disease-card {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 2rpx solid rgba(25, 118, 210, 0.3);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: var(--font-body);
  color: var(--primary-color);
}

.disease-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.disease-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.disease-name {
  width: 100rpx;
  font-size: var(--font-small);
  color: var(--text-primary);
  flex-shrink: 0;
}

.disease-bar-track {
  flex: 1;
  height: 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  overflow: hidden;
}

.disease-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  border-radius: 10rpx;
}

.disease-meta {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.disease-percent {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--primary-color);
}

.disease-count {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.env-card {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 2rpx solid rgba(7, 193, 96, 0.3);
}

.alerts-card {
  margin: 0 30rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.alerts-list {
  display: flex;
  flex-direction: column;
}

.alert-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.alert-item:last-child {
  border-bottom: none;
}

.alert-level-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.alert-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.alert-title {
  font-size: var(--font-body);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.alert-meta {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.alert-arrow {
  display: flex;
  align-items: center;
  color: var(--text-disabled);
}

/* L3 风险横幅 */
.alert-banner {
  margin: 0 30rpx 20rpx;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #fff2f0, #fff0e6);
  border-radius: var(--radius-card);
  border: 1rpx solid #ffccc7;
  font-size: 26rpx;
  color: #cf1322;
  text-align: center;
}

/* 风险卡片 - 当前提醒 */
.risk-factors {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.factors-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.factor-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.factor-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.factor-dot.red {
  background: #ff4d4f;
}

.factor-dot.orange {
  background: #ff7d00;
}

.factor-dot.green {
  background: #52c41a;
}

.factor-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  flex: 1;
}

/* 病害卡片 - 最近检测 */
.recent-detections {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detections-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.detection-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.detection-icon {
  margin-right: 10rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.detection-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.detection-name.high {
  color: #ff4d4f;
  font-weight: 600;
}

.detection-name.medium {
  color: #ff7d00;
  font-weight: 600;
}

.detection-prob {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
  min-width: 44rpx;
  text-align: right;
}

.detection-time {
  font-size: 22rpx;
  color: var(--text-auxiliary);
  min-width: 80rpx;
  text-align: right;
}

.detections-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--primary-color);
  padding: 12rpx 0 0;
}

.reminder-card {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.08);
  border: 2rpx solid rgba(7, 193, 96, 0.2);
}

.reminder-phenology {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.phenology-icon {
  font-size: 48rpx;
}

.phenology-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.phenology-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.phenology-meta {
  font-size: 24rpx;
  color: #999;
}

.reminder-section {
  padding: 12rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.reminder-section-title-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.reminder-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}

.reminder-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}

.disease-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.disease-tag {
  background: #FFF7E6;
  color: #FA8C16;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.reminder-upcoming {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0 0;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.upcoming-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
}

.upcoming-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* ===== 预警提醒卡片 ===== */
.alert-card {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 2rpx solid rgba(229, 57, 53, 0.3);
}

.alert-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.alert-item:last-of-type {
  border-bottom: none;
}

.alert-left {
  flex-shrink: 0;
}

.alert-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.alert-dot.high {
  background: #E53935;
}

.alert-dot.medium {
  background: #FA8C16;
}

.alert-dot.low {
  background: #3D8B40;
}

.alert-right {
  flex: 1;
  min-width: 0;
}

.alert-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.alert-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alert-level-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #fff;
  flex-shrink: 0;
}

.alert-level-tag.high {
  background: #E53935;
}

.alert-level-tag.medium {
  background: #FA8C16;
}

.alert-level-tag.low {
  background: #3D8B40;
}

.alert-meta-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.alert-meta {
  font-size: 22rpx;
  color: #999;
}

.alert-email-status {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #00B42A;
}

.view-all-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 0 0;
  margin-top: 8rpx;
  border-top: 1rpx solid #f0f0f0;
}

.view-all-text {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

/* ===== 当前风险因素卡片 ===== */
.risk-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 0;
}

.risk-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.risk-dot.red {
  background: #E53935;
}

.risk-dot.orange {
  background: #FA8C16;
}

.risk-dot.blue {
  background: #1976D2;
}

.risk-dot.purple {
  background: #7B61FF;
}

.risk-item-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.5;
  flex: 1;
}

.risk-suggestions {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.suggestion-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.suggestion-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}