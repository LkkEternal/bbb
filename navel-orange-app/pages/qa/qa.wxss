/* qa.wxss - 智能问答页面样式 */

.page-container {
  min-height: 100vh;
  background: #F8F9FA;
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.top-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 20rpx;
  background: linear-gradient(180deg, #5B8C5A 0%, #3D6B3D 100%);
}

.nav-back {
  font-size: 50rpx;
  color: #fff;
  width: 60rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

/* 选项卡切换 */
.tabs-bar {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.tab-item {
  flex: 1;
  padding: 25rpx 0;
  text-align: center;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #5B8C5A;
  border-radius: 2rpx;
}

.tab-text {
  font-size: 30rpx;
  color: #4E5969;
}

.tab-item.active .tab-text {
  color: #5B8C5A;
  font-weight: 600;
}

/* 图文求索页面 */
.image-tab-content {
  padding: 20rpx;
}

/* 上传区域 */
.upload-section {
  margin-bottom: 30rpx;
}

.upload-section .section-title {
  font-size: 28rpx;
  color: #4E5969;
  margin-bottom: 20rpx;
  display: block;
}

.upload-area {
  background: #fff;
  border: 2rpx dashed #D9D9D9;
  border-radius: 16rpx;
  padding: 60rpx;
  text-align: center;
  transition: all 0.3s;
}

.upload-area:active {
  border-color: #5B8C5A;
  background: #F0F5F0;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 30rpx;
  color: #1D2129;
  display: block;
  margin-bottom: 10rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #86909C;
}

/* 上传描述 */
.upload-desc {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 20rpx;
}

.desc-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.desc-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.desc-text {
  font-size: 24rpx;
  color: #86909C;
  text-align: center;
}

/* 问答区域 */
.qa-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
}

.qa-input {
  width: 100%;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

/* AI回答区域 */
.ai-answer {
  background: #F8F9FA;
  border-radius: 12rpx;
  padding: 20rpx;
}

.answer-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.answer-icon {
  margin-right: 10rpx;
  display: flex;
  align-items: center;
}

.answer-label {
  font-size: 26rpx;
  color: #5B8C5A;
  font-weight: 600;
}

.answer-content {
  background: #fff;
  border-radius: 8rpx;
  padding: 15rpx;
}

.answer-text {
  font-size: 28rpx;
  color: #1D2129;
  line-height: 1.6;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #86909C;
}

/* 在线问答页面 */
.text-tab-content {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 120rpx);
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 对话区域 */
.chat-container {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
}

.message-item.user {
  justify-content: flex-end;
}

.message-avatar {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.message-item.user .message-avatar {
  order: 2;
}

.message-content {
  max-width: 70%;
  padding: 20rpx 25rpx;
  border-radius: 20rpx;
  margin: 0 15rpx;
}

.message-item.user .message-content {
  background: #5B8C5A;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.message-item.ai .message-content {
  background: #fff;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  display: block;
}

/* Markdown 渲染内容 */
.message-rich {
  font-size: 28rpx;
  line-height: 1.7;
  display: block;
  word-break: break-word;
}

.message-item.user .message-text {
  color: #fff;
}

.message-item.ai .message-text {
  color: #1D2129;
}

.message-time {
  font-size: 20rpx;
  margin-top: 10rpx;
  display: block;
}

.message-item.user .message-time {
  color: rgba(255, 255, 255, 0.7);
  text-align: right;
}

.message-item.ai .message-time {
  color: #86909C;
}

/* 输入区域 */
.input-area {
  position: fixed;
  bottom: 140rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #F0F0F0;
  padding-bottom: calc(15rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.input-box {
  flex: 1;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 100rpx;
  height: 80rpx;
  background: #5B8C5A;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.send-btn:active {
  background: #3D6B3D;
}

.send-btn.disabled {
  background: #ccc;
}

.send-text {
  font-size: 28rpx;
  color: #fff;
}

/* 打字动画点 */
.typing-dot {
  display: inline-block;
  font-size: 40rpx;
  color: #999;
  animation: blink 1.4s infinite;
}
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink {
  0%, 20% { opacity: 0; }
  50% { opacity: 1; }
  100% { opacity: 0; }
}