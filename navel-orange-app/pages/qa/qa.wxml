<!-- qa.wxml - 智能问答页面（Markdown 渲染 + 流式输出） -->
<view class="page-container">
  <!-- 顶部导航栏 -->
  <view class="top-navbar">
    <view class="nav-back" bindtap="goBack">
      <van-icon name="arrow-left" size="36" color="#fff" />
    </view>
    <text class="nav-title">智能问答</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 选项卡切换 -->
  <view class="tabs-bar">
    <view class="tab-item {{currentTab === 'image' ? 'active' : ''}}" bindtap="switchTab" data-tab="image">
      <text class="tab-text">图文求索</text>
    </view>
    <view class="tab-item {{currentTab === 'text' ? 'active' : ''}}" bindtap="switchTab" data-tab="text">
      <text class="tab-text">在线问答</text>
    </view>
  </view>

  <!-- 图文求索页面 -->
  <view wx:if="{{currentTab === 'image'}}" class="image-tab-content">
    <view class="upload-section">
      <text class="section-title">请上传病害叶片</text>
      <view class="upload-area" bindtap="chooseImage">
        <van-icon name="photograph" size="64" color="var(--primary-color)" class="upload-icon" />
        <text class="upload-text">上传图片</text>
        <text class="upload-hint">支持 jpg、png 格式</text>
      </view>
      <view class="upload-desc">
        <view class="desc-item">
          <van-icon name="bar-chart-o" size="32" color="var(--primary-color)" class="desc-icon" />
          <text class="desc-text">海量数据供你参考</text>
        </view>
        <view class="desc-item">
          <van-icon name="share-o" size="32" color="var(--primary-color)" class="desc-icon" />
          <text class="desc-text">一键上传，专业回答</text>
        </view>
        <view class="desc-item">
          <van-icon name="search" size="32" color="var(--primary-color)" class="desc-icon" />
          <text class="desc-text">智能防治，图知检索</text>
        </view>
      </view>
    </view>
    <view class="qa-section">
      <input class="qa-input" placeholder="" value="{{inputText}}" bindinput="onInput" confirm-type="send" bindconfirm="sendMessage" />
      <view wx:if="{{aiAnswer}}" class="ai-answer">
        <view class="answer-header">
          <van-icon name="service-o" size="32" color="var(--primary-color)" class="answer-icon" />
          <text class="answer-label">AI回答</text>
        </view>
        <view class="answer-content">
          <text class="answer-text" user-select="{{true}}">{{aiAnswer}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 在线问答页面 -->
  <view wx:if="{{currentTab === 'text'}}" class="text-tab-content">
    <scroll-view class="chat-container" scroll-y scroll-into-view="chat-bottom" scroll-with-animation>
      <view wx:for="{{chatMessages}}" wx:key="id" class="message-item {{item.type === 'user' ? 'user' : 'ai'}}">
        <view class="message-avatar">
          <van-icon name="{{item.type === 'user' ? 'contact' : 'service-o'}}" size="36" color="#fff" />
        </view>
        <view class="message-content">
          <!-- AI消息用 rich-text 渲染 Markdown，用户消息用普通 text -->
          <block wx:if="{{item.type === 'ai'}}">
            <rich-text nodes="{{item.htmlContent || item.content}}" user-select="{{true}}" class="message-rich" />
            <block wx:if="{{item.isTyping}}">
              <text class="typing-dot">.</text>
              <text class="typing-dot">.</text>
              <text class="typing-dot">.</text>
            </block>
          </block>
          <text wx:else class="message-text" user-select="{{true}}">{{item.content}}</text>
          <text class="message-time">{{item.time}}</text>
        </view>
      </view>
      <view id="chat-bottom"></view>
    </scroll-view>

    <!-- 输入区域 -->
    <view class="input-area">
      <input class="input-box" placeholder="有什么办法防治溃疡病？" value="{{inputText}}" bindinput="onInput" confirm-type="send" bindconfirm="sendMessage" />
      <view class="send-btn {{isWaiting ? 'disabled' : ''}}" bindtap="sendMessage">
        <text class="send-text">{{isWaiting ? '...' : '发送'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部全局导航栏 -->
  <custom-tabbar current-page="/pages/qa/qa"></custom-tabbar>
</view>
