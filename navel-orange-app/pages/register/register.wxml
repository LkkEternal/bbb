<!-- pages/register/register.wxml - 已替换 Emoji → Vant 图标 -->
<view class="container">
  <view class="bg-image"></view>
  
  <view class="register-box">
    <view class="logo-section">
      <view class="logo-icon">
        <van-icon name="gem-o" size="40" color="#fff" />
      </view>
      <text class="title">注册新账号</text>
      <text class="subtitle">加入智能脐橙病虫害监测平台</text>
    </view>
    
    <view class="form-section">
      <!-- 手机号 -->
      <view class="form-item">
        <text class="label">手机号</text>
        <view class="input-wrapper">
          <van-icon name="phone-o" size="36" color="#FF8C00" class="input-icon" />
          <input 
            class="input" 
            placeholder="请输入手机号" 
            value="{{phone}}" 
            bindinput="onPhoneInput" 
            type="number" 
            maxlength="11" 
          />
        </view>
      </view>
      
      <!-- 用户名 -->
      <view class="form-item">
        <text class="label">用户名</text>
        <view class="input-wrapper">
          <van-icon name="contact" size="36" color="#FF8C00" class="input-icon" />
          <input 
            class="input" 
            placeholder="请输入用户名（2-20位）" 
            value="{{username}}" 
            bindinput="onUsernameInput" 
            maxlength="20" 
          />
        </view>
      </view>
      
      <!-- 密码 -->
      <view class="form-item">
        <text class="label">密码</text>
        <view class="input-wrapper">
          <van-icon name="lock" size="36" color="#FF8C00" class="input-icon" />
          <input 
            class="input" 
            type="{{showPassword ? 'text' : 'password'}}" 
            placeholder="请输入密码（6-20位）" 
            value="{{password}}" 
            bindinput="onPasswordInput" 
            maxlength="20" 
          />
          <text class="eye-icon" bindtap="togglePassword">
            <van-icon name="{{showPassword ? 'eye-o' : 'closed-eye'}}" size="32" color="#999" />
          </text>
        </view>
      </view>
      
      <!-- 确认密码 -->
      <view class="form-item">
        <text class="label">确认密码</text>
        <view class="input-wrapper">
          <van-icon name="lock" size="36" color="#FF8C00" class="input-icon" />
          <input 
            class="input" 
            type="{{showConfirmPassword ? 'text' : 'password'}}" 
            placeholder="请再次输入密码" 
            value="{{confirmPassword}}" 
            bindinput="onConfirmPasswordInput" 
            maxlength="20" 
          />
          <text class="eye-icon" bindtap="toggleConfirmPassword">
            <van-icon name="{{showConfirmPassword ? 'eye-o' : 'closed-eye'}}" size="32" color="#999" />
          </text>
        </view>
      </view>
      
      <!-- 验证码 -->
      <view class="form-item">
        <view class="label-row">
          <text class="label">验证码</text>
          <text 
            class="send-code" 
            bindtap="sendSmsCode" 
            disabled="{{smsDisabled}}"
          >
            {{smsButtonText}}
          </text>
        </view>
        <view class="input-wrapper">
          <van-icon name="chat-o" size="36" color="#FF8C00" class="input-icon" />
          <input 
            class="input" 
            placeholder="请输入验证码" 
            value="{{smsCode}}" 
            bindinput="onSmsCodeInput" 
            type="number" 
            maxlength="6" 
          />
        </view>
      </view>
      
      <!-- 注册按钮（使用 van-button） -->
      <van-button 
        color="linear-gradient(135deg, #FF8C00, #FF6B00)"
        round 
        block 
        custom-class="register-btn"
        bindtap="onRegister"
      >
        注册
      </van-button>
      
      <!-- 登录链接 -->
      <view class="login-row">
        <text class="login-text">已有账号？</text>
        <text class="login-link" bindtap="goToLogin">立即登录</text>
      </view>
      
      <!-- 协议勾选 -->
      <view class="agreement-section">
        <view class="checkbox" bindtap="toggleAgreement">
          <view 
            class="checkbox-inner" 
            style="border-color: {{agreed ? '#FF8C00' : '#ccc'}}; background-color: {{agreed ? '#FF8C00' : 'transparent'}}"
          >
            <van-icon wx:if="{{agreed}}" name="checked" size="24" color="#fff" />
          </view>
        </view>
        <text class="agreement-text">我已阅读并同意</text>
        <text class="agreement-link">用户协议</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link">隐私政策</text>
      </view>
    </view>
  </view>
</view>
