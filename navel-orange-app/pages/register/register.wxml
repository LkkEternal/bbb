<view class="container">
  <!-- ===== 顶部渐变视觉区 ===== -->
  <view class="hero-section">
    <view class="status-bar" style="--status-bar-height: {{statusBarHeight * 2 || 88}}rpx;"></view>
    <view class="hero-content">
      <text class="hero-greeting">一起出发</text>
      <text class="hero-subtitle">解锁精准农事提醒与病害预警</text>
    </view>
  </view>

  <!-- ===== 白色注册卡片 ===== -->
  <view class="login-card">
    <!-- 卡片头部 -->
    <view class="card-header">
      <text class="header-tab active">注册新账号</text>
    </view>

    <!-- 手机号 -->
    <view class="form-group">
      <text class="form-label">手机号</text>
      <view class="input-field">
        <input class="input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" type="number" maxlength="11" />
      </view>
    </view>

    <!-- 用户名 -->
    <view class="form-group">
      <text class="form-label">用户名</text>
      <view class="input-field">
        <input class="input" placeholder="请输入用户名（2-20位）" value="{{username}}" bindinput="onUsernameInput" maxlength="20" />
      </view>
    </view>

    <!-- 密码 -->
    <view class="form-group">
      <text class="form-label">密码</text>
      <view class="input-field">
        <input class="input" type="password" placeholder="请输入密码（6-20位）" value="{{password}}" bindinput="onPasswordInput" maxlength="20" />
      </view>
    </view>

    <!-- 确认密码 -->
    <view class="form-group">
      <text class="form-label">确认密码</text>
      <view class="input-field">
        <input class="input" type="password" placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" maxlength="20" />
      </view>
    </view>

    <!-- 验证码 -->
    <view class="form-group">
      <text class="form-label">验证码</text>
      <view class="input-field code-field">
        <input class="input code-input" placeholder="请输入验证码" value="{{smsCode}}" bindinput="onSmsCodeInput" type="number" maxlength="6" />
        <view class="code-divider"></view>
        <text class="code-btn {{smsDisabled ? 'disabled' : ''}}" bindtap="sendSmsCode">{{smsButtonText}}</text>
      </view>
    </view>

    <!-- 邮箱 -->
    <view class="form-group">
      <text class="form-label">邮箱</text>
      <view class="input-field">
        <input class="input" placeholder="请输入邮箱" value="{{email}}" bindinput="onEmailInput" type="text" />
      </view>
    </view>

    <!-- 注册按钮 -->
    <view class="login-btn" bindtap="onRegister">
      <text class="login-btn-text">注 册</text>
    </view>

    <!-- 协议勾选 -->
    <view class="agreement-row" bindtap="toggleAgreement">
      <view class="check-box {{agreed ? 'checked' : ''}}">
        <van-icon wx:if="{{agreed}}" name="success" size="14" color="#fff" />
      </view>
      <text class="agree-text">我已阅读并同意</text>
      <text class="agree-link" catchtap="onViewAgreement">《用户协议》</text>
      <text class="agree-text">和</text>
      <text class="agree-link" catchtap="onViewPrivacy">《隐私政策》</text>
    </view>

    <!-- 登录入口 -->
    <view class="register-row">
      <text class="register-text">已有账号？</text>
      <text class="register-link" bindtap="goToLogin">返回登录</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>
