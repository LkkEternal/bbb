/* pages/register/register.wxss */
.container {
  min-height: 100vh;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9, #A5D6A7);
  z-index: 0;
}

.register-box {
  position: relative;
  z-index: 1;
  width: 90%;
  max-width: 650rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.08);
}

.logo-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C00, #FF6B00);
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 0, 0.3);
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.form-section {
  padding: 0 10rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.send-code {
  font-size: 24rpx;
  color: #FF8C00;
}

.send-code[disabled] {
  color: #ccc;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 25rpx;
  height: 88rpx;
}

.input-icon {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon {
  margin-right: 20rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.eye-icon {
  display: flex;
  align-items: center;
  cursor: pointer;
  flex-shrink: 0;
}

/* van-button 自定义样式覆盖 */
.register-btn {
  width: 100% !important;
  height: 88rpx !important;
  margin-top: 30rpx !important;
  margin-bottom: 24rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  border: none !important;
  box-shadow: 0 6rpx 20rpx rgba(255, 140, 0, 0.3) !important;
}

.login-row {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.login-text {
  font-size: 24rpx;
  color: #999;
}

.login-link {
  font-size: 24rpx;
  color: #FF8C00;
  margin-left: 10rpx;
}

.agreement-section {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.checkbox {
  margin-right: 10rpx;
}

.checkbox-inner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ccc;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  color: #fff;
}

.agreement-text {
  font-size: 22rpx;
  color: #999;
}

.agreement-link {
  font-size: 22rpx;
  color: #FF8C00;
}