/* ===== 全局容器 ===== */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

/* ===== 顶部渐变视觉区（35%） ===== */
.hero-section {
  height: 35vh;
  min-height: 300rpx;
  background: linear-gradient(135deg, #d8c8f8 0%, #b096e9 100%);
  display: flex;
  flex-direction: column;
  padding: 0 40rpx;
  position: relative;
}

.status-bar {
  padding-top: var(--status-bar-height, 88rpx);
  background: transparent;
  flex-shrink: 0;
}

.hero-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 40rpx;
}

.hero-greeting {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
  line-height: 1.4;
  letter-spacing: 1rpx;
}

/* ===== 白色登录卡片 ===== */
.login-card {
  background: #ffffff;
  border-radius: 24px;
  margin: -24px 20px 0 20px;
  padding: 0 24px 32px;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 10;
}

/* ===== 卡片头部 - 标签栏 ===== */
.card-header {
  display: flex;
  align-items: center;
  padding: 24px 0 20px 0;
}

.header-tab {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  position: relative;
}

.header-tab::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #7c5cbf;
  border-radius: 2rpx;
}

/* ===== 表单组 ===== */
.form-group {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: #1A1A1A;
  margin-bottom: 8px;
}

.input-field {
  background: #f5f7fa;
  border-radius: 20px;
  height: 52px;
  padding: 0 20px;
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  height: 52px;
  font-size: 28rpx;
  color: #1A1A1A;
  background: transparent;
  border: none;
  min-width: 0;
}

.input::placeholder {
  color: #B0B4B8;
  font-size: 26rpx;
}

/* ===== 验证码输入 ===== */
.code-field {
  padding-right: 0;
}

.code-input {
  padding-right: 16px;
}

.code-divider {
  width: 2rpx;
  height: 28px;
  background: #e0e0e0;
  flex-shrink: 0;
}

.code-btn {
  flex-shrink: 0;
  padding: 0 20px;
  font-size: 26rpx;
  color: #7c5cbf;
  font-weight: 500;
  white-space: nowrap;
  height: 52px;
  display: flex;
  align-items: center;
}

.code-btn.disabled {
  color: #ccc;
}

/* ===== 注册按钮 ===== */
.login-btn {
  width: 100%;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24px;
  background: linear-gradient(135deg, #9b8ed8, #b096e9);
  box-shadow: 0 6px 24px rgba(155, 142, 216, 0.35);
  margin-top: 32px;
  margin-bottom: 20px;
}

.login-btn-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}

/* ===== 协议勾选 ===== */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 8px;
}

.check-box {
  width: 14px;
  height: 14px;
  border: 1.5px solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  flex-shrink: 0;
  margin-right: 4px;
}

.check-box.checked {
  background: #7c5cbf;
  border-color: #7c5cbf;
}

.agree-text {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.agree-link {
  font-size: 22rpx;
  color: #7c5cbf;
  font-weight: 500;
  line-height: 1.5;
}

/* ===== 登录入口 ===== */
.register-row {
  text-align: center;
  margin-top: 8px;
}

.register-text {
  font-size: 26rpx;
  color: #333;
}

.register-link {
  font-size: 26rpx;
  color: #7c5cbf;
  font-weight: 600;
  margin-left: 4rpx;
}

/* ===== 底部空白 ===== */
.bottom-spacer {
  flex: 1;
  min-height: 40px;
}
