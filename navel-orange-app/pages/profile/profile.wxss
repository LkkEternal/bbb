.container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.user-header {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 100rpx 30rpx 50rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-circle);
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-circle);
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
}

.avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: var(--radius-circle);
  display: flex;
  justify-content: center;
  align-items: center;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.phone {
  font-size: var(--font-auxiliary);
  color: rgba(255, 255, 255, 0.8);
}

.menu-section {
  padding: 30rpx;
}

.menu-card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  margin-right: 20rpx;
  width: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.menu-text {
  flex: 1;
  font-size: var(--font-body);
  color: var(--text-primary);
}

.menu-arrow {
  display: flex;
  align-items: center;
}

.logout-section {
  padding: 0 30rpx 30rpx;
}

.logout-btn {
  background: var(--card-bg);
  border-radius: var(--radius-button);
  padding: 25rpx;
  text-align: center;
  font-size: var(--font-body);
  color: var(--danger-color);
  border: 2rpx solid var(--danger-color);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  padding: 10rpx;
}

.modal-body {
  padding: 20rpx 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: var(--font-body);
  color: var(--text-auxiliary);
}

.info-value {
  font-size: var(--font-body);
  color: var(--text-primary);
  text-align: right;
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-footer {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 20rpx 30rpx 30rpx;
}

.modal-btn {
  flex: 1;
  padding: 22rpx;
  text-align: center;
  font-size: var(--font-body);
  border-radius: var(--radius-button);
  background: var(--page-bg);
  color: var(--text-secondary);
}

.modal-btn-primary {
  background: var(--primary-color);
  color: #fff;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: var(--page-bg);
  border-radius: var(--radius-small);
  padding: 0 20rpx;
  font-size: var(--font-body);
  color: var(--text-primary);
  box-sizing: border-box;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.switch-row:last-child {
  border-bottom: none;
}

.switch-label {
  display: flex;
  flex-direction: column;
}

.switch-title {
  font-size: var(--font-body);
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.switch-desc {
  font-size: var(--font-small);
  color: var(--text-auxiliary);
}

.switch-control {
  flex-shrink: 0;
}