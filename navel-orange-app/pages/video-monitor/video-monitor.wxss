/* video-monitor.wxss - 视频监控 + 云台控制样式（优化版） */

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  background: var(--page-bg, #f5f5f5);
  padding-bottom: 40rpx;
}

/* ===== 顶部导航栏 ===== */
.top-navbar {
  background: linear-gradient(135deg, var(--primary-color, #07c160), var(--primary-dark, #06ad56));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-back, .nav-right {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

/* ===== ① 视频地址栏（始终显示） ===== */
.address-bar {
  margin: 20rpx 30rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.address-label {
  font-size: 28rpx;
  color: var(--text-auxiliary, #999);
  display: block;
  margin-bottom: 12rpx;
}

.address-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.address-protocol {
  font-size: 30rpx;
  color: var(--text-secondary, #666);
  flex-shrink: 0;
}

.address-input {
  flex: 1;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 12rpx;
  font-size: 30rpx;
  text-align: center;
  min-width: 0;
}

.address-input.port {
  flex: 0 0 110rpx;
}

.address-colon, .address-slash {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.address-apply {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  background: var(--primary-color, #07c160);
  color: #fff;
  font-size: 28rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.address-apply::after {
  border: none;
}

/* ===== 视频区域 ===== */
.video-section {
  position: relative;
  margin: 16rpx 30rpx 0;
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-image {
  width: 100%;
  height: 100%;
}

.placeholder {
  text-align: center;
  padding: 60rpx 40rpx;
}

.placeholder-title {
  display: block;
  font-size: 32rpx;
  color: #999;
  margin-top: 20rpx;
}

.placeholder-desc {
  display: block;
  font-size: 26rpx;
  color: #777;
  margin-top: 10rpx;
}

/* ===== 状态栏 ===== */
.status-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot.green { background: #22c55e; }
.status-dot.red { background: #ef4444; }
.status-dot.yellow { background: #eab308; animation: blink 1.2s infinite; }
.status-dot.gray { background: #666; }

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.status-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  flex: 1;
}

.status-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.connect-btn {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.8;
}

.connect-btn.primary {
  background: var(--primary-color, #07c160);
  color: #fff;
}

.connect-btn.danger {
  background: #ef4444;
  color: #fff;
}

/* ===== ② 云台控制区域 ===== */
.ptz-section {
  margin: 16rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #333);
}

/* PTZ 输入项 — stepper 风格 */
.ptz-item {
  margin-bottom: 20rpx;
}

.ptz-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ptz-label {
  font-size: 34rpx;
  color: var(--text-auxiliary, #999);
  flex-shrink: 0;
}

.ptz-stepper {
  display: flex;
  align-items: center;
  gap: 0;
}

.ptz-btn {
  width: 72rpx;
  height: 72rpx;
  background: #e8e8e8;
  color: #333;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.ptz-btn:active {
  background: #d0d0d0;
}

.ptz-input {
  width: 120rpx;
  height: 72rpx;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  margin: 0 8rpx;
  padding: 0 10rpx;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  color: var(--text-primary, #333);
}

/* ===== ③ 下发云台控制按钮（inline-block 绿色仅包裹文字） ===== */
.ptz-btn-wrapper {
  text-align: center;
  margin: 16rpx 0 10rpx;
}

.ptz-send-btn {
  display: inline-block;
  padding: 18rpx 40rpx;
  background: var(--primary-color, #07c160);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
  line-height: 1.4;
  letter-spacing: 2rpx;
}

.ptz-send-btn::after {
  border: none;
}

.ptz-send-btn[disabled] {
  opacity: 0.6;
}

/* ===== 快捷定位 ===== */
.quick-section {
  margin-top: 20rpx;
}

.quick-label {
  font-size: 26rpx;
  color: var(--text-auxiliary, #999);
  display: block;
  margin-bottom: 16rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
}

.quick-btn {
  flex: 1;
  padding: 12rpx 8rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--text-primary, #333);
  background: #fafafa;
  text-align: center;
}

.quick-btn:active {
  background: var(--primary-color, #07c160);
  color: #fff;
  border-color: var(--primary-color, #07c160);
}

/* ===== 命令日志 ===== */
.log-section {
  margin-top: 24rpx;
}

.log-clear {
  font-size: 24rpx;
  color: var(--primary-color, #07c160);
  padding: 4rpx 12rpx;
}

.log-scroll {
  max-height: 260rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.log-line {
  display: flex;
  gap: 12rpx;
  font-size: 24rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eee;
  line-height: 1.6;
}

.log-line:last-child {
  border-bottom: none;
}

.log-line.success {
  color: var(--text-secondary, #666);
}

.log-line.error {
  color: #ef4444;
}

.log-time {
  color: #bbb;
  flex-shrink: 0;
  font-family: monospace;
}

.log-msg {
  flex: 1;
}

.log-empty {
  text-align: center;
  padding: 20rpx 0;
  color: #ccc;
  font-size: 24rpx;
}
