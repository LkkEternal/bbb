.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  color: #fff;
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
  height: 60rpx;
}

.loading-tip,
.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--text-auxiliary);
}

.detection-list {
  padding: 25rpx 30rpx;
}

.detection-card {
  display: flex;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.detection-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-small);
  background: #f5f5f5;
  flex-shrink: 0;
}

.detection-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.detection-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detection-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detection-name.high {
  color: #ff4d4f;
}

.detection-name.medium {
  color: #ff7d00;
}

.detection-prob {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.detection-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detection-device {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.detection-time {
  font-size: 22rpx;
  color: var(--text-auxiliary);
}

.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--text-auxiliary);
}
