/* alert-detail.wxss - 预警详情页样式 */

.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 顶部导航栏 */
.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  color: #fff;
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

/* 预警级别标签 */
.alert-level-badge {
  margin: 25rpx 30rpx;
  padding: 15rpx 30rpx;
  border-radius: var(--radius-button);
  text-align: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.alert-level-badge.l1 {
  background: rgba(0, 180, 42, 0.1);
  color: var(--success-color);
}

.alert-level-badge.l2 {
  background: rgba(255, 125, 0, 0.1);
  color: var(--warning-color);
}

.alert-level-badge.l3 {
  background: rgba(245, 63, 63, 0.1);
  color: var(--danger-color);
}

/* 内容卡片 */
.content-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.alert-title {
  display: block;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 15rpx;
}

.alert-time {
  display: block;
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  margin-bottom: 20rpx;
}

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin-bottom: 20rpx;
}

.alert-content {
  font-size: var(--font-body);
  color: var(--text-secondary);
  line-height: 1.8;
}

/* 防治建议卡片 */
.suggestion-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
}

.suggestion-num {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--primary-color);
  color: #fff;
  border-radius: 50%;
  font-size: var(--font-small);
  font-weight: 600;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.suggestion-text {
  font-size: var(--font-body);
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 关联信息卡片 */
.info-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-item {
  display: flex;
  flex-direction: column;
  width: 45%;
}

.info-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: var(--card-bg);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
  font-weight: 600;
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: var(--text-secondary);
}