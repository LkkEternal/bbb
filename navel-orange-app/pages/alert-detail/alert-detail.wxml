<!-- alert-detail.wxml - 预警详情页（按设计稿重写） -->
<view class="page-container">
  <!-- ===== 顶部导航栏 ===== -->
  <view class="top-navbar">
    <view class="nav-back" bindtap="goBack">
      <van-icon name="arrow-left" size="32" color="#fff" />
    </view>
    <text class="nav-title">预警详情</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- ===== 加载骨架屏 ===== -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <van-skeleton title row="6" row-width="{{['100%', '90%', '80%', '100%', '90%', '80%']}}" />
  </view>

  <!-- ===== 主要内容（非加载状态） ===== -->
  <view wx:else class="scroll-content">

    <!-- ===== 等级 + 基本信息合并卡片（渐变背景） ===== -->
    <view class="level-badge-card level-{{alert.levelClass}}">
      <view class="header-row">
        <van-icon name="warn-o" size="48" color="#fff" />
        <text class="level-badge-text">L{{alert.levelNum}} {{alert.levelText}}</text>
      </view>
      <view class="header-row">
        <text class="header-label">果园：</text>
        <text class="header-value">{{alert.orchardName || '未知'}}</text>
      </view>
      <view class="header-row">
        <text class="header-label">风险评分：</text>
        <text class="header-value">{{riskScore}}/100</text>
      </view>
      <!-- 进度条 -->
      <view class="risk-progress-wrap">
        <van-progress
          percentage="{{riskScore}}"
          stroke-width="12"
          color="{{progressColor}}"
          track-color="rgba(255,255,255,0.3)"
          pivot-text="{{riskScore}}%"
          pivot-color="{{progressColor}}"
        />
      </view>
      <!-- 病害名称+置信度小标签 -->
      <view wx:if="{{diseaseInfo.name}}" class="disease-badge">
        <van-tag color="rgba(255,255,255,0.25)" text-color="#fff" size="large">
          {{diseaseInfo.name}} · 置信度 {{diseaseInfo.probability}}%
        </van-tag>
      </view>
    </view>

    <!-- ===== 预警内容卡片 ===== -->
    <view class="section-card">
      <view class="section-header">
        <van-icon name="notes-o" size="32" color="#1989fa" />
        <text class="section-title">预警内容</text>
      </view>
      <view class="info-table">
        <view class="info-row">
          <text class="info-key">触发规则</text>
          <text class="info-value">物候，温湿度</text>
        </view>
        <view wx:if="{{alert.phenology}}" class="info-row">
          <text class="info-key">当前物候</text>
          <text class="info-value">{{alert.phenology}}</text>
        </view>
        <view wx:if="{{alert.environmentText}}" class="info-row">
          <text class="info-key">环境数据</text>
          <text class="info-value">{{alert.environmentText}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 防治建议卡片（组合式） ===== -->
    <view class="section-card">
      <view class="section-header">
        <van-icon name="bulb-o" size="32" color="#07c160" />
        <text class="section-title">防治建议</text>
      </view>
      <view wx:if="{{suggestions.length > 0}}" class="suggestion-list">
        <view wx:for="{{suggestions}}" wx:for-index="idx" wx:key="index" class="suggestion-item">
          <text class="suggestion-circle">{{getCircleNum(idx)}}</text>
          <text class="suggestion-text">{{item}}</text>
        </view>
      </view>
      <view wx:if="{{consequences}}" class="warning-section warning-consequences">
        <text class="warning-icon">⚠️</text>
        <text class="warning-label">不处理的后果：</text>
        <text class="warning-text">{{consequences}}</text>
      </view>
      <view wx:if="{{urgency}}" class="warning-section warning-urgency">
        <text class="warning-icon">🔴</text>
        <text class="warning-label">紧急程度：</text>
        <text class="warning-text">{{urgency}}</text>
      </view>
    </view>

    <!-- ===== 通知状态卡片 ===== -->
    <view class="section-card">
      <view class="section-header">
        <van-icon name="envelop-o" size="32" color="#7232dd" />
        <text class="section-title">通知状态</text>
      </view>
      <view class="notify-row">
        <text class="notify-label">邮件：</text>
        <text wx:if="{{pushEmailStatus === 'sent'}}" class="notify-value notify-success">✅ {{pushEmailStatusText}}</text>
        <text wx:elif="{{pushEmailStatus === 'failed'}}" class="notify-value notify-fail">❌ {{pushEmailStatusText}}</text>
        <text wx:else class="notify-value notify-pending">⏳ {{pushEmailStatusText}}</text>
      </view>
    </view>

    <!-- ===== 上传处理证据卡片 ===== -->
    <view class="section-card">
      <view class="section-header">
        <van-icon name="photograph" size="32" color="#ee6a3d" />
        <text class="section-title">上传处理证据</text>
      </view>

      <!-- 已上传图片预览 -->
      <view wx:if="{{treatmentImages.length > 0}}" class="image-grid">
        <view wx:for="{{treatmentImages}}" wx:key="index" class="image-grid-item">
          <image src="{{item}}" mode="aspectFill" class="treatment-image" />
        </view>
      </view>

      <!-- 相机上传按钮（居中） -->
      <view class="upload-center" wx:if="{{!processed}}">
        <van-icon name="photograph" size="80" color="#FF8C00" bindtap="chooseTreatmentImage" />
        <text class="upload-tip" bindtap="chooseTreatmentImage">点击上传处理照片</text>
        <view class="process-btn-wrap">
          <van-button type="success" size="small" round bindtap="markAsProcessed" loading="{{processing}}">标记已处理</van-button>
        </view>
      </view>

      <!-- 已处理标签（居中） -->
      <view class="processed-center" wx:if="{{processed}}">
        <text class="processed-tag">✅ 已处理</text>
      </view>
    </view>

    <!-- ===== 底部占位 ===== -->
    <view class="bottom-spacer"></view>
  </view>
</view>
