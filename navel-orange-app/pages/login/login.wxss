/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fff;
}

/* ===== 自定义状态栏 ===== */
.status-bar {
  padding-top: var(--status-bar-height, 88rpx);
  background: #fff;
  position: relative;
  z-index: 10;
}

/* ===== 内容区域（滚动） ===== */
.content-wrapper {
  flex: 1;
  padding: 0 40rpx 48rpx;
  display: flex;
  flex-direction: column;
}

/* ===== Hero / Logo 区域 ===== */
.hero {
  text-align: center;
  padding: 20rpx 0 40rpx;
}
.logo-icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ff8c00, #ff6b00);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 0, 0.3);
}
.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* ===== 表单区域 ===== */
.form-section {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ===== Tab 切换器 ===== */
.tab-switcher {
  display: flex;
  border-radius: 16rpx;
  background: #f5f5f5;
  padding: 6rpx;
  margin-bottom: 40rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
  color: #888;
  transition: all 0.3s;
}
.tab-item.active {
  color: #ff6b00;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  font-weight: 600;
}

/* ===== 输入组 ===== */
.input-group {
  margin-bottom: 28rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 10rpx;
}
.input-wrapper {
  display: flex;
  align-items: center;
  border: 2rpx solid #e8e8e8;
  border-radius: 20rpx;
  padding: 0 24rpx;
  background: #fafafa;
  transition: border-color 0.25s;
}
.input-wrapper:focus-within {
  border-color: #ff8c00;
  background: #fff;
}
.input-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}
.input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #1a1a1a;
  background: transparent;
  border: none;
  min-width: 0;
}
.input::placeholder {
  color: #c5c5c5;
  font-size: 28rpx;
}
.eye-icon {
  padding: 16rpx;
  flex-shrink: 0;
}

/* ===== 短信验证码行 ===== */
.sms-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}
.sms-input-wrapper {
  flex: 1;
}
.sms-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ff8c00, #ff6b00);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  min-height: 88rpx;
}
.sms-btn.disabled {
  opacity: 0.5;
}

/* ===== 登录按钮 ===== */
.login-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ff8c00, #ff6b00);
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 0, 0.35);
  margin-bottom: 28rpx;
}
.login-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 8rpx;
}

/* ===== 注册入口 ===== */
.register-row {
  text-align: center;
  margin-bottom: 40rpx;
}
.register-text {
  font-size: 28rpx;
  color: #888;
}
.register-link {
  font-size: 28rpx;
  color: #ff6b00;
  font-weight: 600;
  margin-left: 4rpx;
}

/* ===== 协议勾选 ===== */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6rpx;
}
.check-box {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #d0d0d0;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  flex-shrink: 0;
}
.check-box.checked {
  background: #ff6b00;
  border-color: #ff6b00;
}
.agree-text {
  font-size: 24rpx;
  color: #aaa;
}
.agree-link {
  font-size: 24rpx;
  color: #ff6b00;
  font-weight: 500;
}
