/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--gradient-bg);
  z-index: 0;
}

.login-box {
  position: relative;
  z-index: 1;
  width: 90%;
  max-width: 650rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.08);
}

.logo-section {
  text-align: center;
  margin-bottom: 50rpx;
}

.logo-icon {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-circle);
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0 auto 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 140, 90, 0.3);
}

.title {
  display: block;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.form-section {
  padding: 0 20rpx;
}

.login-tabs {
  display: flex;
  background: var(--page-bg);
  border-radius: var(--radius-small);
  padding: 6rpx;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: var(--font-body);
  color: var(--text-secondary);
  border-radius: var(--radius-small);
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
}

.form-item {
  margin-bottom: 30rpx;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.label {
  font-size: var(--font-body);
  color: var(--text-secondary);
  margin-bottom: 15rpx;
}

.send-code {
  font-size: var(--font-auxiliary);
  color: var(--primary-color);
}

.send-code[disabled] {
  color: var(--text-disabled);
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: var(--page-bg);
  border-radius: var(--radius-small);
  padding: 0 25rpx;
  height: 88rpx;
}

.input-icon {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon {
  margin-right: 20rpx;
}

.input {
  flex: 1;
  font-size: var(--font-body);
  color: var(--text-primary);
}

.eye-icon {
  display: flex;
  align-items: center;
  cursor: pointer;
  flex-shrink: 0;
}

/* van-button 自定义样式覆盖 */
.login-btn {
  width: 100% !important;
  height: 88rpx !important;
  margin-top: 40rpx !important;
  margin-bottom: 30rpx !important;
  font-size: var(--font-title) !important;
  font-weight: 600 !important;
  box-shadow: 0 6rpx 20rpx rgba(91, 140, 90, 0.3) !important;
}

.register-row {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
}

.register-text {
  font-size: var(--font-auxiliary);
  color: var(--text-secondary);
}

.register-link {
  font-size: var(--font-auxiliary);
  color: var(--primary-color);
  margin-left: 10rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  padding: 0 20rpx;
  font-size: var(--font-small);
  color: var(--text-auxiliary);
}

.third-party {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 40rpx;
}

.third-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-circle);
  display: flex;
  justify-content: center;
  align-items: center;
}

.third-icon.wechat {
  background: linear-gradient(135deg, #2DB95B, #1A8F44);
}


.agreement-section {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.checkbox {
  margin-right: 10rpx;
}

.checkbox-inner {
  width: 32rpx;
  height: 32rpx;
  border-radius: var(--radius-small);
  border: 2rpx solid var(--text-disabled);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  color: #fff;
}

.agreement-text {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.agreement-link {
  font-size: var(--font-auxiliary);
  color: var(--primary-color);
}