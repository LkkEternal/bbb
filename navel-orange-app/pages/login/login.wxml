<!-- login.wxml - 登录页面（参考设计稿：状态栏 + Logo + Tab切换 + 记住我 + 协议勾选） -->
<view class="container">

  <!-- ===== 状态栏 ===== -->
  <view class="status-bar" style="--status-bar-height: {{statusBarHeight * 2 || 88}}rpx;">
  </view>

  <!-- ===== 内容区域 ===== -->
  <view class="content-wrapper">

    <!-- Logo 区域 -->
    <view class="hero">
      <view class="logo-icon">
        <van-icon name="gem-o" size="48" color="#fff" />
      </view>
      <text class="hero-title">智能脐橙监测平台</text>
    </view>

    <!-- 表单区域 -->
    <view class="form-section">

      <!-- 登录方式 Tab 切换 -->
      <view class="tab-switcher">
        <view
          class="tab-item {{loginType === 'password' ? 'active' : ''}}"
          data-type="password"
          bindtap="switchLoginType"
        >密码登录</view>
        <view
          class="tab-item {{loginType === 'sms' ? 'active' : ''}}"
          data-type="sms"
          bindtap="switchLoginType"
        >短信登录</view>
      </view>

      <!-- 手机号 -->
      <view class="input-group">
        <text class="label">手机号</text>
        <view class="input-wrapper">
          <van-icon name="phone-o" size="36" color="#bbb" class="input-icon" />
          <input
            class="input"
            placeholder="请输入手机号"
            value="{{phone}}"
            bindinput="onPhoneInput"
            type="number"
            maxlength="11"
          />
        </view>
      </view>

      <!-- 密码（仅密码登录模式） -->
      <view class="input-group" wx:if="{{loginType === 'password'}}">
        <text class="label">密码</text>
        <view class="input-wrapper">
          <van-icon name="lock" size="36" color="#bbb" class="input-icon" />
          <input
            class="input"
            type="{{showPassword ? 'text' : 'password'}}"
            placeholder="请输入密码"
            value="{{password}}"
            bindinput="onPasswordInput"
          />
          <text class="eye-icon" bindtap="togglePassword">
            <van-icon name="{{showPassword ? 'eye-o' : 'closed-eye'}}" size="32" color="#c5c5c5" />
          </text>
        </view>
      </view>

      <!-- 验证码（仅短信登录模式） -->
      <view class="input-group" wx:if="{{loginType === 'sms'}}">
        <text class="label">验证码</text>
        <view class="sms-row">
          <view class="input-wrapper sms-input-wrapper">
            <van-icon name="chat-o" size="36" color="#bbb" class="input-icon" />
            <input
              class="input"
              placeholder="请输入验证码"
              value="{{smsCode}}"
              bindinput="onSmsCodeInput"
              type="number"
              maxlength="6"
            />
          </view>
          <view
            class="sms-btn {{smsDisabled ? 'disabled' : ''}}"
            bindtap="sendSmsCode"
          >
            {{smsButtonText}}
          </view>
        </view>
      </view>

      <!-- 登录按钮 -->
      <view class="login-btn" bindtap="onLogin">
        <text class="login-btn-text">登 录</text>
      </view>

      <!-- 注册入口 -->
      <view class="register-row">
        <text class="register-text">还没有账号？</text>
        <text class="register-link" bindtap="goToRegister">立即注册</text>
      </view>

      <!-- 协议勾选 -->
      <view class="agreement-row" bindtap="toggleAgreement">
        <view class="check-box {{agreed ? 'checked' : ''}}">
          <van-icon wx:if="{{agreed}}" name="success" size="16" color="#fff" />
        </view>
        <text class="agree-text">我已阅读并同意</text>
        <text class="agree-link" catchtap="onViewAgreement">《用户协议》</text>
        <text class="agree-text">和</text>
        <text class="agree-link" catchtap="onViewPrivacy">《隐私政策》</text>
      </view>

    </view>
  </view>
</view>
