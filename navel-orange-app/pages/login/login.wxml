<view class="container">
  <!-- ===== 顶部渐变视觉区 ===== -->
  <view class="hero-section">
    <view class="status-bar" style="--status-bar-height: {{statusBarHeight * 2 || 88}}rpx;"></view>
    <view class="hero-content">
      <text class="hero-greeting">Hello!</text>
      <text class="hero-subtitle">欢迎使用脐橙智能监测系统</text>
    </view>
  </view>

  <!-- ===== 中间白色登录卡片 ===== -->
  <view class="login-card">
    <!-- 卡片头部 - 登录方式切换 -->
    <view class="card-header">
      <view class="header-tab {{loginType === 'sms' ? 'active' : ''}}" data-type="sms" bindtap="switchLoginType">短信登录</view>
      <view class="header-tab {{loginType === 'password' ? 'active' : ''}}" data-type="password" bindtap="switchLoginType">密码登录</view>
    </view>

    <!-- 账号输入 -->
    <view class="form-group">
      <text class="form-label">账号</text>
      <view class="input-field">
        <input class="input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" type="number" maxlength="11" />
      </view>
    </view>

    <!-- 密码输入（密码登录） -->
    <view class="form-group" wx:if="{{loginType === 'password'}}">
      <text class="form-label">密码</text>
      <view class="input-field">
        <input class="input" type="{{showPassword ? 'text' : 'password'}}" placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
        <text class="eye-icon" bindtap="togglePassword">
          <van-icon name="{{showPassword ? 'eye-o' : 'closed-eye'}}" size="32" color="#c5c5c5" />
        </text>
      </view>
    </view>

    <!-- 验证码输入（短信登录） -->
    <view class="form-group" wx:if="{{loginType === 'sms'}}">
      <text class="form-label">验证码</text>
      <view class="input-field code-field">
        <input class="input code-input" placeholder="请输入验证码" value="{{smsCode}}" bindinput="onSmsCodeInput" type="number" maxlength="6" />
        <view class="code-divider"></view>
        <text class="code-btn {{smsDisabled ? 'disabled' : ''}}" bindtap="sendSmsCode">{{smsButtonText}}</text>
      </view>
    </view>

    <!-- 登录按钮 -->
    <view class="login-btn" bindtap="onLogin">
      <text class="login-btn-text">登录</text>
    </view>

    <!-- 协议勾选 -->
    <view class="agreement-row" bindtap="toggleAgreement">
      <view class="check-box {{agreed ? 'checked' : ''}}">
        <van-icon wx:if="{{agreed}}" name="success" size="14" color="#fff" />
      </view>
      <text class="agree-text">我已阅读并同意</text>
      <text class="agree-link" catchtap="onViewAgreement">《用户协议》</text>
      <text class="agree-text">和</text>
      <text class="agree-link" catchtap="onViewPrivacy">《隐私政策》</text>
    </view>

    <!-- 注册入口 -->
    <view class="register-row">
      <text class="register-text">还没有账号？</text>
      <text class="register-link" bindtap="goToRegister">立即注册</text>
    </view>
  </view>

  <!-- ===== 底部空白 ===== -->
  <view class="bottom-spacer"></view>
</view>
