/* pages/welcome/welcome.wxss */

.container {
  min-height: 100vh;
  background: #faf6f0;
}

/* ========== 新手指南样式 ========== */
.guide-section {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #fce4d6 0%, #f5d0b8 100%);
}

.guide-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 300rpx;
  height: 300rpx;
  top: -50rpx;
  right: -50rpx;
}

.circle-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: 200rpx;
  left: -60rpx;
}

.circle-3 {
  width: 150rpx;
  height: 150rpx;
  bottom: -30rpx;
  right: 100rpx;
}

.guide-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 60rpx 40rpx;
}

.step-indicator {
  display: flex;
  gap: 16rpx;
  margin-bottom: 60rpx;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  transition: all 0.3s;
}

.step-dot.active {
  width: 48rpx;
  background: #fff;
}

.step-dot.completed {
  background: rgba(255, 255, 255, 0.6);
}

.guide-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 80rpx 50rpx;
  width: 100%;
  max-width: 600rpx;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.guide-icon {
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
}

.guide-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.guide-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.guide-buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 30rpx;
  margin-top: 60rpx;
  width: 100%;
  max-width: 600rpx;
}

.btn-skip, .btn-prev {
  padding: 24rpx 40rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.btn-next {
  flex: 1;
  padding: 24rpx 40rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #764ba2;
  background: #fff;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.btn-next:active {
  transform: scale(0.98);
}

/* ========== 创建果园样式 ========== */
.create-section {
  min-height: 100vh;
  background: #faf6f0;
}

.create-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 60rpx 30rpx 30rpx;
  background: #fff;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  color: #333;
}

.create-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.skip-btn {
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  color: #FF8C00;
}

.create-form {
  padding: 30rpx;
}

.welcome-tip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 30rpx;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #2E7D32;
  flex: 1;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.eye-icon {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.required {
  color: #ff4d4f;
}

.form-input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}

.picker-wrapper {
  padding: 0;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

.custom-variety-wrapper {
  margin-top: 16rpx;
}

.submit-section {
  padding: 40rpx 30rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF8C00, #FF6B00);
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 0, 0.3);
}

.submit-btn[disabled] {
  opacity: 0.7;
}

.submit-btn:active {
  transform: scale(0.98);
}