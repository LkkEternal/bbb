.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  padding: 8rpx 0;
  padding-bottom: calc(8rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-button);
  transition: all 0.3s;
}

.tab-item.active {
  background: rgba(91, 140, 90, 0.08);
}

.tab-icon {
  margin-bottom: 6rpx;
  opacity: 0.5;
}

.tab-item.active .tab-icon {
  opacity: 1;
  --van-icon-color: var(--primary-color);
}

.tab-text {
  font-size: 20rpx;
  color: var(--text-auxiliary);
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: var(--primary-color);
  font-weight: 600;
}
