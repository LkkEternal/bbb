<view class="custom-tabbar">
  <view 
    wx:for="{{tabList}}" 
    wx:key="pagePath" 
    class="tab-item {{currentPage === item.pagePath ? 'active' : ''}}"
    bindtap="switchTab"
    data-path="{{item.pagePath}}"
  >
    <van-icon name="{{item.icon}}" size="40" class="tab-icon" />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>