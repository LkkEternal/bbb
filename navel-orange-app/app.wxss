/**app.wxss**/

/* 全局样式变量 - 设计规范 */
page {
  /* 主色调（绿色系）*/
  --primary-color: #5B8C5A;      /* 森林绿 - 主色 */
  --primary-light: #8FBC8F;      /* 淡绿 - 浅色 */
  --primary-dark: #3D6B3D;       /* 深绿 - 深色 */
  
  /* 背景色 */
  --page-bg: #F8F9FA;            /* 浅灰白 - 页面背景 */
  --card-bg: #FFFFFF;            /* 纯白 - 卡片背景 */
  --gradient-bg: linear-gradient(180deg, #f0f5ff 0%, #F8F9FA 100%);  /* 渐变背景 */
  
  /* 语义色 */
  --success-color: #00B42A;      /* 成功 - 绿色 */
  --warning-color: #FF7D00;      /* 警告 - 橙色 */
  --danger-color: #F53F3F;       /* 危险 - 红色 */
  --high-risk-color: #FF4d4f;    /* 高风险 - 亮红 */
  --medium-risk-color: #FFA940;  /* 中风险 - 橙色 */
  --low-risk-color: #52C41A;     /* 低风险 - 绿色 */
  
  /* 文字色 */
  --text-primary: #1D2129;       /* 主要文字 */
  --text-secondary: #4E5969;     /* 次要文字 */
  --text-auxiliary: #86909C;     /* 辅助文字 */
  --text-disabled: #C9CDD4;      /* 禁用文字 */
  
  /* 字体大小（750rpx基准）*/
  --font-large-title: 40rpx;     /* 大标题 */
  --font-title: 34rpx;           /* 标题 */
  --font-subtitle: 30rpx;        /* 副标题 */
  --font-body: 28rpx;            /* 正文 */
  --font-auxiliary: 24rpx;       /* 辅助文字 */
  --font-small: 22rpx;           /* 小字/标签 */
  
  /* 圆角规范 */
  --radius-card: 16rpx;          /* 卡片圆角 */
  --radius-button: 48rpx;        /* 按钮圆角（全圆角胶囊）*/
  --radius-small: 8rpx;          /* 小元素圆角 */
  --radius-circle: 999rpx;       /* 头像圆角（完全圆形）*/
  
  /* 基础样式 */
  background-color: var(--page-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: 1.5;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 通用卡片样式 */
.card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 通用按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
  font-weight: 500;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
}

.btn-secondary {
  background: var(--card-bg);
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

.btn-warning {
  background: linear-gradient(135deg, var(--warning-color), #E67000);
  color: #fff;
}

.btn-danger {
  background: linear-gradient(135deg, var(--danger-color), #E03535);
  color: #fff;
}

/* 文本截断 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 通用间距 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }

.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }

.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }