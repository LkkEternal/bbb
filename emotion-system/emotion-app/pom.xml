<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.emotion</groupId>
        <artifactId>emotion-system</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>emotion-app</artifactId>
    <packaging>jar</packaging>
    <name>emotion-app</name>
    <description>应用启动模块</description>

    <dependencies>
        <dependency>
            <groupId>com.emotion</groupId>
            <artifactId>emotion-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.emotion</groupId>
            <artifactId>emotion-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.emotion</groupId>
            <artifactId>emotion-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.emotion</groupId>
            <artifactId>emotion-detection</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.emotion</groupId>
            <artifactId>emotion-admin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.emotion</groupId>
            <artifactId>emotion-chat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.emotion</groupId>
            <artifactId>emotion-weather</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
