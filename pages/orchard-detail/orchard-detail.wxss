/* orchard-detail.wxss - 果园详情页样式 */

.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 顶部导航栏 */
.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  color: #fff;
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.nav-edit {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
}

/* 果园信息卡片 */
.info-card {
  margin: 25rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.orchard-name {
  display: block;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.orchard-address {
  display: block;
  font-size: var(--font-body);
  color: var(--text-secondary);
  margin-bottom: 25rpx;
}

.info-row {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  margin-bottom: 6rpx;
}

.info-value {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

/* 通用区域标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.section-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.section-sub {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.section-more {
  font-size: var(--font-body);
  color: var(--primary-color);
}

/* 成员信息卡片 */
.member-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: var(--radius-small);
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  background: var(--primary-light);
  border-radius: var(--radius-circle);
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.member-phone {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.member-role {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-circle);
  font-size: var(--font-small);
  font-weight: 500;
}

.member-role.owner {
  background: rgba(0, 180, 42, 0.1);
  color: #00b42a;
}

.member-role.manager {
  background: rgba(255, 125, 0, 0.1);
  color: #ff7d00;
}

.member-role.viewer {
  background: rgba(134, 144, 156, 0.1);
  color: #86909c;
}

/* 设备管理卡片 */
.device-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.device-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: var(--radius-small);
}

.device-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  background: #e8f5e9;
  border-radius: var(--radius-circle);
  margin-right: 20rpx;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.device-name {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.device-type {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.device-status {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-circle);
  font-size: var(--font-small);
  font-weight: 500;
}

.device-status.online {
  background: rgba(0, 180, 42, 0.1);
  color: #00b42a;
}

.device-status.offline {
  background: rgba(245, 63, 63, 0.1);
  color: #f53f3f;
}

/* 环境趋势图卡片 */
.env-trend-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 图例 */
.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 30rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

.legend-dot.temp-dot {
  background: linear-gradient(135deg, #ff7d00, #ff4d4f);
}

.legend-dot.humidity-dot {
  background: linear-gradient(135deg, #165dff, #722ed1);
}

.legend-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 图表容器 */
.trend-chart {
  display: flex;
  background: #fafafa;
  border-radius: var(--radius-small);
  padding: 20rpx 10rpx 60rpx 60rpx;
  position: relative;
}

/* Y轴刻度 */
.y-axis-scale {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 60rpx;
  height: 400rpx;
  position: absolute;
  left: 10rpx;
  top: 20rpx;
}

.scale-label {
  font-size: 20rpx;
  color: var(--text-auxiliary);
  text-align: right;
}

/* 图表主体 */
.chart-body {
  flex: 1;
  height: 400rpx;
  position: relative;
  margin-left: 10rpx;
}

/* 网格线 */
.grid-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: #e8e8e8;
}

/* 数据点组 */
.data-point-group {
  position: absolute;
  transform: translateX(-50%);
}

/* 数据点 */
.data-point {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  transform: translate(-50%, 50%);
  z-index: 3;
}

.data-point.temp-point {
  background: linear-gradient(135deg, #ff7d00, #ff4d4f);
  box-shadow: 0 2rpx 8rpx rgba(255, 125, 0, 0.5);
}

.data-point.humidity-point {
  background: linear-gradient(135deg, #165dff, #722ed1);
  box-shadow: 0 2rpx 8rpx rgba(22, 93, 255, 0.5);
}

.point-label {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
}

/* 连线 */
.connect-line {
  position: absolute;
  height: 4rpx;
  z-index: 2;
}

.connect-line.temp-line {
  background: linear-gradient(90deg, #ff7d00, #ff4d4f);
  opacity: 0.8;
}

.connect-line.humidity-line {
  background: linear-gradient(90deg, #165dff, #722ed1);
  opacity: 0.8;
}

/* X轴日期 */
.x-axis-labels {
  position: absolute;
  bottom: -50rpx;
  left: 0;
  right: 0;
}

.x-label {
  position: absolute;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: var(--text-auxiliary);
  white-space: nowrap;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-auxiliary);
  font-size: 28rpx;
}

/* 环境趋势卡片 */
.env-trend-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.trend-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 12rpx;
}

.trend-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.trend-row.even {
  background: #fafafa;
  border-radius: 8rpx;
}

.trend-col {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-primary);
}

.trend-col.date-col {
  flex: 1.2;
  text-align: left;
  color: var(--text-secondary);
}

.trend-col.temp-col {
  color: #ff7d00;
  font-weight: 500;
}

.trend-col.humidity-col {
  color: #165dff;
  font-weight: 500;
}

.trend-col.trend-icon {
  font-size: 28rpx;
  font-weight: 600;
}

.trend-col.trend-icon.up {
  color: #ff4d4f;
}

.trend-col.trend-icon.down {
  color: #52c41a;
}

.trend-col.trend-icon.flat {
  color: #999;
}

/* 识别统计卡片 */
.detection-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.stats-overview {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stat-value.alert {
  color: var(--danger-color);
}

.stat-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.sub-title {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: block;
}

/* 病害分布 */
.disease-distribution {
  margin-bottom: 30rpx;
}

.pie-chart {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pie-visual {
  width: 200rpx;
  height: 200rpx;
}

.pie-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
  background: #f0f0f0;
}

.pie-slice {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transform-origin: 50% 50%;
}

.pie-legend {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.legend-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.legend-count {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-right: 10rpx;
}

.legend-percent {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
  width: 80rpx;
  text-align: right;
}

/* 识别记录 */
.detection-records {
  margin-top: 20rpx;
}

.detection-item {
  display: flex;
  padding: 20rpx;
  background: #fafafa;
  border-radius: var(--radius-small);
  margin-bottom: 16rpx;
}

.detection-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-small);
  margin-right: 20rpx;
  background: #f0f0f0;
}

.detection-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.detection-info .disease-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.detection-info .confidence {
  font-size: 24rpx;
  color: #ff7d00;
}

.detection-info .device-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.detection-info .detection-time {
  font-size: 22rpx;
  color: var(--text-auxiliary);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0;
  color: var(--primary-color);
  font-size: 28rpx;
  font-weight: 500;
  background: #f5f5f5;
  border-radius: var(--radius-small);
  margin-top: 16rpx;
}

.load-more:active {
  background: #e8e8e8;
}

/* 病害历史卡片 */
.detection-card {
  margin: 0 30rpx 25rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.detection-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detection-item {
  display: flex;
  padding: 20rpx;
  background: #fafafa;
  border-radius: var(--radius-small);
}

.detection-thumb {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  background: #f0f0f0;
  border-radius: var(--radius-small);
  margin-right: 20rpx;
}

.detection-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.detection-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.detection-name {
  font-size: var(--font-body);
  font-weight: 500;
  color: var(--text-primary);
}

.detection-confidence {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--danger-color);
}

.detection-meta {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-auxiliary);
  font-size: var(--font-body);
}