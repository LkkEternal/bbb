/* recognition.wxss - 自动识别页面样式 */

.container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.navbar {
  background: var(--card-bg);
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--primary-color);
}

.recognition-area {
  padding: 30rpx;
}

.camera-box {
  width: 100%;
  height: 400rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  border: 3rpx dashed var(--text-disabled);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.camera-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.camera-text {
  font-size: var(--font-body);
  color: var(--text-auxiliary);
}

.preview-area {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.preview-img {
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius-small);
  margin-bottom: 20rpx;
}

.preview-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
}

.action-btn.cancel {
  background: var(--page-bg);
  color: var(--text-secondary);
}

.action-btn.confirm {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 200;
}

.loading-content {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: var(--font-body);
  color: var(--text-secondary);
}

.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 200;
  padding: 30rpx;
}

.result-content {
  width: 100%;
  max-width: 600rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
}

.result-img {
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius-small);
  margin-bottom: 20rpx;
}

.result-info {
  margin-bottom: 30rpx;
}

.result-title {
  display: block;
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.result-confidence {
  display: block;
  font-size: var(--font-body);
  color: var(--primary-color);
  margin-bottom: 15rpx;
}

.result-desc {
  display: block;
  font-size: var(--font-auxiliary);
  color: var(--text-secondary);
  line-height: 1.6;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.result-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
  background: var(--page-bg);
  color: var(--text-secondary);
}

.result-btn.primary {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
}