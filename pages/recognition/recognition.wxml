<!-- recognition.wxml - 自动识别页面 -->
<view class="container">
  <view class="navbar">
    <text class="nav-title">果园</text>
  </view>
  
  <view class="recognition-area">
    <view class="camera-box" bindtap="chooseImage">
      <view class="camera-icon">📷</view>
      <text class="camera-text">点击拍照或选择图片</text>
    </view>
    
    <view wx:if="{{selectedImage}}" class="preview-area">
      <image src="{{selectedImage}}" class="preview-img" mode="aspectFill" />
      <view class="preview-actions">
        <view class="action-btn cancel" bindtap="cancelImage">取消</view>
        <view class="action-btn confirm" bindtap="startRecognition">开始识别</view>
      </view>
    </view>
  </view>
  
  <view wx:if="{{recognizing}}" class="loading-overlay">
    <view class="loading-content">
      <view class="loading-icon">🔍</view>
      <text class="loading-text">识别中...</text>
    </view>
  </view>
  
  <view wx:if="{{recognitionResult}}" class="result-modal">
    <view class="result-content">
      <image src="{{selectedImage}}" class="result-img" mode="aspectFill" />
      <view class="result-info">
        <text class="result-title">{{recognitionResult.disease_name}}</text>
        <text class="result-confidence">置信度: {{recognitionResult.confidence_percent}}%</text>
        <text class="result-desc">{{recognitionResult.description}}</text>
      </view>
      <view class="result-actions">
        <view class="result-btn" bindtap="closeResult">关闭</view>
        <view class="result-btn primary" bindtap="viewDetail">查看详情</view>
      </view>
    </view>
  </view>
  
  <!-- 底部全局导航栏 -->
  <custom-tabbar current-page="/pages/recognition/recognition"></custom-tabbar>
</view>