<!-- report.wxml - 数据报告页面 -->
<view class="container">
  <view class="navbar">
    <text class="nav-title">知识</text>
  </view>
  
  <view class="report-content">
    <view class="summary-card">
      <view class="summary-header">
        <text class="summary-title">果园概况</text>
        <text class="summary-date">2026年6月</text>
      </view>
      <view class="summary-stats">
        <view class="summary-item">
          <text class="summary-value">50.5</text>
          <text class="summary-label">亩</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">2</text>
          <text class="summary-label">高风险区</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">15%</text>
          <text class="summary-label">感病率</text>
        </view>
      </view>
    </view>
    
    <view class="chart-card">
      <view class="chart-header">
        <text class="chart-title">病害趋势</text>
      </view>
      <view class="chart-content">
        <view class="chart-bars">
          <view class="bar-item">
            <view class="bar" style="height: 60%"></view>
            <text class="bar-label">周一</text>
          </view>
          <view class="bar-item">
            <view class="bar" style="height: 80%"></view>
            <text class="bar-label">周二</text>
          </view>
          <view class="bar-item">
            <view class="bar" style="height: 45%"></view>
            <text class="bar-label">周三</text>
          </view>
          <view class="bar-item">
            <view class="bar" style="height: 90%"></view>
            <text class="bar-label">周四</text>
          </view>
          <view class="bar-item">
            <view class="bar" style="height: 70%"></view>
            <text class="bar-label">周五</text>
          </view>
          <view class="bar-item">
            <view class="bar" style="height: 85%"></view>
            <text class="bar-label">周六</text>
          </view>
          <view class="bar-item">
            <view class="bar" style="height: 75%"></view>
            <text class="bar-label">周日</text>
          </view>
        </view>
      </view>
    </view>
    
    <view class="detail-card">
      <view class="detail-header">
        <text class="detail-title">病害统计</text>
      </view>
      <view class="detail-list">
        <view class="detail-item">
          <view class="detail-info">
            <text class="detail-name">溃疡病</text>
            <text class="detail-count">检测到 12 次</text>
          </view>
          <view class="detail-progress">
            <view class="progress-bar" style="width: 80%"></view>
          </view>
        </view>
        <view class="detail-item">
          <view class="detail-info">
            <text class="detail-name">炭疽病</text>
            <text class="detail-count">检测到 8 次</text>
          </view>
          <view class="detail-progress">
            <view class="progress-bar" style="width: 55%"></view>
          </view>
        </view>
        <view class="detail-item">
          <view class="detail-info">
            <text class="detail-name">健康果实</text>
            <text class="detail-count">检测到 45 次</text>
          </view>
          <view class="detail-progress">
            <view class="progress-bar healthy" style="width: 100%"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 底部全局导航栏 -->
  <custom-tabbar current-page="/pages/report/report"></custom-tabbar>
</view>