/* report.wxss - 数据报告页面样式 */

.container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.navbar {
  background: var(--card-bg);
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--primary-color);
}

.report-content {
  padding: 30rpx;
}

.summary-card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.summary-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.summary-date {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.summary-stats {
  display: flex;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.summary-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  margin-top: 10rpx;
}

.chart-card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.chart-header {
  margin-bottom: 30rpx;
}

.chart-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.chart-content {
  height: 200rpx;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 100%;
  padding-top: 20rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar {
  width: 40rpx;
  background: linear-gradient(180deg, var(--primary-color), var(--primary-light));
  border-radius: var(--radius-small) var(--radius-small) 0 0;
  margin-bottom: 10rpx;
}

.bar-label {
  font-size: var(--font-small);
  color: var(--text-auxiliary);
}

.detail-card {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.detail-header {
  margin-bottom: 25rpx;
}

.detail-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.detail-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-name {
  font-size: var(--font-body);
  color: var(--text-primary);
}

.detail-count {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.detail-progress {
  height: 12rpx;
  background: var(--page-bg);
  border-radius: var(--radius-small);
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--high-risk-color), var(--warning-color));
  border-radius: var(--radius-small);
}

.progress-bar.healthy {
  background: linear-gradient(90deg, var(--success-color), var(--low-risk-color));
}