<!-- alert-detail.wxml - 预警详情页 -->
<view class="page-container">
  <!-- 顶部导航栏 -->
  <view class="top-navbar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">预警详情</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 预警级别标签 -->
  <view class="alert-level-badge {{alert.levelClass}}">
    {{alert.levelText}}预警
  </view>

  <!-- 预警内容卡片 -->
  <view class="content-card">
    <text class="alert-title">{{alert.title || '预警消息'}}</text>
    <text class="alert-time">{{alert.time || '未知时间'}}</text>
    <view class="divider"></view>
    <text class="alert-content">{{alert.content || '暂无详情'}}</text>
  </view>

  <!-- 防治建议卡片 -->
  <view class="suggestion-card">
    <view class="section-header">
      <text class="section-title">💡 防治建议</text>
    </view>
    <view class="suggestion-list">
      <view wx:for="{{suggestions}}" wx:key="index" class="suggestion-item">
        <view class="suggestion-num">{{index + 1}}</view>
        <text class="suggestion-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 关联信息卡片 -->
  <view class="info-card">
    <view class="section-header">
      <text class="section-title">📋 关联信息</text>
    </view>
    <view class="info-row">
      <view class="info-item">
        <text class="info-label">关联果园</text>
        <text class="info-value">{{alert.orchardName || '未知'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">检测设备</text>
        <text class="info-value">{{alert.deviceName || '未知'}}</text>
      </view>
    </view>
    <view class="info-row">
      <view class="info-item">
        <text class="info-label">预警类型</text>
        <text class="info-value">{{alert.typeName || '未知'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">严重程度</text>
        <text class="info-value">{{alert.severityText || '未知'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="action-bar">
    <view class="action-btn primary" bindtap="handleAlert">
      处理预警
    </view>
    <view class="action-btn secondary" bindtap="shareAlert">
      分享预警
    </view>
  </view>

  <!-- 底部全局导航栏 -->
  <custom-tabbar current-page="/pages/alert/alert"></custom-tabbar>
</view>