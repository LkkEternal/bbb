/* orchard.wxss - 果园列表页样式 */

.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 顶部导航栏 */
.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.nav-right {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.add-icon {
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
}

/* 果园列表 */
.orchard-list {
  padding: 25rpx 30rpx;
}

/* 果园卡片 */
.orchard-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 25rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 卡片背景区域 */
.card-bg {
  padding: 40rpx 30rpx;
  position: relative;
}

.card-bg::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.orchard-name {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

/* 角色标签 */
.role-badge {
  font-size: var(--font-small);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-circle);
}

.role-badge.owner {
  background: rgba(0, 180, 42, 0.9);
  color: #fff;
}

.role-badge.manager {
  background: rgba(255, 125, 0, 0.9);
  color: #fff;
}

.role-badge.viewer {
  background: rgba(134, 144, 156, 0.9);
  color: #fff;
}

.orchard-location {
  font-size: var(--font-body);
  color: rgba(255, 255, 255, 0.85);
}

/* 卡片底部统计 */
.card-footer {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background: #f0f0f0;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 24rpx 60rpx;
  background: linear-gradient(135deg, #FF8C00, #FF6B00);
  border-radius: 48rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 0, 0.3);
}

.empty-btn:active {
  transform: scale(0.98);
}

/* ========== 加载状态 ========== */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 创建果园弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-content {
  width: 90%;
  max-width: 650rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
}

.form-input-wrapper {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 8rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 88rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

.custom-variety-wrapper {
  margin-top: 16rpx;
}

.modal-footer {
  display: flex;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #FF8C00, #FF6B00);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 0, 0.3);
}

.modal-btn.confirm[disabled] {
  opacity: 0.7;
}

.modal-btn:active {
  transform: scale(0.98);
}