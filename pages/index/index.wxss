.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.nav-right {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.notification-icon {
  font-size: 40rpx;
}

.notification-badge {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: var(--danger-color);
  border-radius: var(--radius-circle);
  font-size: var(--font-small);
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 8rpx;
}

.orchard-selector {
  margin: 20rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-button);
  padding: 25rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.selector-content {
  display: flex;
  align-items: center;
}

.selector-icon {
  font-size: 36rpx;
  margin-right: 15rpx;
}

.selector-text {
  font-size: var(--font-body);
  color: var(--text-primary);
}

.selector-arrow {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.no-orchard-tip {
  text-align: center;
  padding: 40rpx 30rpx;
  color: var(--text-auxiliary);
  font-size: var(--font-body);
  background: var(--card-bg);
  margin: 0 30rpx 25rpx;
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.risk-card {
  margin: 0 30rpx 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.risk-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.risk-level-tag {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-button);
}

.risk-level-tag.low {
  background: #E8F8E8;
  color: #00B42A;
}

.risk-level-tag.medium {
  background: #FFF7E6;
  color: #FF7D00;
}

.risk-level-tag.high {
  background: #FFECE8;
  color: #F53F3F;
}

.risk-tag-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.risk-tag-text {
  font-size: 34rpx;
  font-weight: 700;
}

.risk-score-box {
  display: flex;
  align-items: baseline;
}

.risk-score-num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.risk-score-den {
  font-size: var(--font-auxiliary);
  color: var(--text-disabled);
  margin-left: 4rpx;
}

.risk-bar {
  margin-bottom: 24rpx;
}

.risk-bar-track {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.risk-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.risk-bar-fill.low {
  background: linear-gradient(90deg, #52C41A, #73D13D);
}

.risk-bar-fill.medium {
  background: linear-gradient(90deg, #FFA940, #FF7D00);
}

.risk-bar-fill.high {
  background: linear-gradient(90deg, #FF4d4f, #F53F3F);
}

.risk-metrics {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.risk-metric {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.metric-icon {
  font-size: 28rpx;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.metric-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.risk-desc {
  display: block;
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  line-height: 1.5;
}

.disease-card {
  margin: 0 30rpx 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.section-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: var(--font-body);
  color: var(--primary-color);
}

.disease-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.disease-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.disease-name {
  width: 100rpx;
  font-size: var(--font-small);
  color: var(--text-primary);
  flex-shrink: 0;
}

.disease-bar-track {
  flex: 1;
  height: 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  overflow: hidden;
}

.disease-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--primary-light));
  border-radius: 10rpx;
}

.disease-meta {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.disease-percent {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--primary-color);
}

.disease-count {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.env-card {
  margin: 0 30rpx 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx 30rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.alerts-card {
  margin: 0 30rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.alerts-list {
  display: flex;
  flex-direction: column;
}

.alert-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.alert-item:last-child {
  border-bottom: none;
}

.alert-level-icon {
  font-size: 24rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.alert-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.alert-title {
  font-size: var(--font-body);
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.alert-meta {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.alert-arrow {
  font-size: var(--font-title);
  color: var(--text-disabled);
}