<view class="container">
  <view class="top-navbar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">我的反馈</text>
    <view class="nav-placeholder"></view>
  </view>

  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{list.length === 0}}" class="empty-container">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无反馈记录</text>
  </view>

  <scroll-view wx:else class="list-container" scroll-y bindscrolltolower="loadMore">
    <view wx:for="{{list}}" wx:key="id" wx:for-item="card" wx:for-index="cardIdx" class="feedback-card">
      <view class="card-header">
        <text class="orchard-name">🏡 {{card.orchardName}}</text>
        <text class="status-tag {{card.reviewStatusClass}}">{{card.reviewStatusText}}</text>
      </view>

      <view class="card-divider"></view>

      <view class="card-body">
        <text class="type-tag">{{card.feedbackTypeText}}</text>
        <text class="body-desc">{{card.description}}</text>
      </view>

      <view wx:if="{{card.showImages}}" class="card-images">
        <block wx:for="{{card.images}}" wx:key="url" wx:for-item="img" wx:for-index="imgIdx">
          <image wx:if="{{!img.failed}}" class="image-cell-img"
                 src="{{img.url}}" mode="aspectFill"
                 binderror="onImageError"
                 bindtap="previewImage"
                 data-card-index="{{cardIdx}}" data-img-index="{{imgIdx}}" />
          <view wx:else class="img-placeholder" bindtap="previewImage" data-card-index="{{cardIdx}}" data-img-index="{{imgIdx}}">
            <text class="img-placeholder-icon">🌿</text>
            <text class="img-placeholder-text">图片加载失败</text>
          </view>
        </block>
      </view>

      <view class="card-footer">
        <text class="footer-time">🕐 {{card.createdAt}}</text>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more">
      <text class="load-more-text">加载更多...</text>
    </view>
    <view wx:else class="load-more">
      <text class="load-more-text">— 没有更多了 —</text>
    </view>
  </scroll-view>

  <view wx:if="{{previewVisible}}" class="preview-overlay" bindtap="closePreview">
    <view class="preview-container" catchtap="noop">
      <image class="preview-image" src="{{previewUrl}}" mode="widthFix" />
      <view class="preview-close" bindtap="closePreview">
        <text>✕</text>
      </view>
    </view>
  </view>
</view>