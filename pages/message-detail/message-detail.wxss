.page-container {
  min-height: 100vh;
  background: var(--page-bg);
}

.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-back {
  font-size: 44rpx;
  color: #fff;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.detail-body {
  padding: 30rpx;
  padding-bottom: 120rpx;
}

.detail-header {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.detail-level {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: var(--font-auxiliary);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.detail-level.high {
  background: #FFECE8;
  color: #F53F3F;
}

.detail-level.medium {
  background: #FFF7E6;
  color: #FF7D00;
}

.detail-level.low {
  background: #E8F8E8;
  color: #00B42A;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  line-height: 1.4;
}

.detail-section {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.detail-sec-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.detail-content {
  font-size: var(--font-body);
  color: var(--text-secondary);
  line-height: 1.8;
}

.advice-box {
  background: #FFFBE6;
  border-left: 6rpx solid #FF7D00;
  padding: 20rpx;
  border-radius: 8rpx;
}

.advice-text {
  font-size: var(--font-body);
  color: var(--text-primary);
  line-height: 1.7;
}

.detail-meta {
  background: var(--card-bg);
  border-radius: var(--radius-card);
  padding: 24rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.meta-label {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

.meta-value {
  font-size: var(--font-auxiliary);
  color: var(--text-secondary);
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  text-align: center;
  font-size: var(--font-body);
  color: #fff;
  background: var(--primary-color);
  font-weight: 600;
}