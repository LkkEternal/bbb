/* alert.wxss - 预警消息页样式 */

.page-container {
  min-height: 100vh;
  background: var(--page-bg);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 顶部导航栏 */
.top-navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  color: #fff;
}

.nav-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

/* 筛选标签栏 */
.filter-bar {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 15rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  font-size: var(--font-body);
  padding: 12rpx 25rpx;
  border-radius: var(--radius-button);
  color: var(--text-secondary);
  background: #f5f5f5;
}

.filter-item.active {
  color: #fff;
  background: var(--primary-color);
}

/* 预警列表 */
.alert-list {
  padding: 20rpx 30rpx;
}

.alert-card {
  display: flex;
  padding: 25rpx;
  margin-bottom: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.06);
}

.alert-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
  padding-top: 5rpx;
}

.level-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.level-dot.l1 {
  background: var(--success-color);
}

.level-dot.l2 {
  background: var(--warning-color);
}

.level-dot.l3 {
  background: var(--danger-color);
}

.read-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.read-dot.unread {
  background: var(--danger-color);
}

.read-dot.read {
  background: transparent;
  border: 2rpx solid #C9CDD4;
}

.alert-content {
  flex: 1;
}

.alert-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.alert-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
}

.alert-level {
  font-size: var(--font-small);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-circle);
}

.alert-level.l1 {
  background: rgba(0, 180, 42, 0.1);
  color: var(--success-color);
}

.alert-level.l2 {
  background: rgba(255, 125, 0, 0.1);
  color: var(--warning-color);
}

.alert-level.l3 {
  background: rgba(245, 63, 63, 0.1);
  color: var(--danger-color);
}

.alert-desc {
  display: block;
  font-size: var(--font-body);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.alert-time {
  font-size: var(--font-auxiliary);
  color: var(--text-auxiliary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: var(--font-body);
  color: var(--text-auxiliary);
}