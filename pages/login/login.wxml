<!--
  login.wxml - 登录页面结构文件
  作用：定义登录页面的UI结构和布局
-->

<!-- 页面容器 -->
<view class="container">
  <!-- 背景图：全屏背景，使用果园图片 -->
  <view class="bg-image"></view>
  
  <!-- 登录表单区域：白色半透明卡片 -->
  <view class="login-box">
    <!-- Logo区域：显示平台Logo和名称 -->
    <view class="logo-section">
      <!-- Logo区域：使用文字图标替代远程图片，避免网络加载失败 -->
      <view class="logo-icon">🍊</view>
      <!-- 平台名称 -->
      <text class="title">智能脐橙病虫害监测平台</text>
      <!-- 平台标语 -->
      <text class="subtitle">让脐橙种植更智慧、更简单</text>
    </view>
    
    <!-- 表单区域 -->
    <view class="form-section">
      <!-- 登录方式切换：密码登录 / 短信登录 -->
      <view class="login-tabs">
        <!-- 密码登录标签：使用data-type传递参数 -->
        <view 
          class="tab-item {{loginType === 'password' ? 'active' : ''}}" 
          bindtap="switchLoginType"
          data-type="password"
        >
          密码登录
        </view>
        <!-- 短信登录标签：使用data-type传递参数 -->
        <view 
          class="tab-item {{loginType === 'sms' ? 'active' : ''}}" 
          bindtap="switchLoginType"
          data-type="sms"
        >
          短信登录
        </view>
      </view>
      
      <!-- 手机号输入框 -->
      <view class="form-item">
        <text class="label">手机号</text>
        <view class="input-wrapper">
          <!-- 图标 -->
          <text class="icon">👤</text>
          <!-- 输入框：type="number"限制只能输入数字，maxlength="11"限制11位 -->
          <input 
            class="input" 
            placeholder="请输入手机号" 
            value="{{phone}}" 
            bindinput="onPhoneInput" 
            type="number" 
            maxlength="11" 
          />
        </view>
      </view>
      
      <!-- 密码输入框：只有选择密码登录时显示 -->
      <view class="form-item" wx:if="{{loginType === 'password'}}">
        <view class="label-row">
          <text class="label">密码</text>
          <!-- 忘记密码链接 -->
          <text class="forgot-link" bindtap="goToForgotPassword">忘记密码？</text>
        </view>
        <view class="input-wrapper">
          <text class="icon">🔒</text>
          <!-- 密码输入框：type根据showPassword切换明文/密文 -->
          <input 
            class="input" 
            type="{{showPassword ? 'text' : 'password'}}" 
            placeholder="请输入登录密码" 
            value="{{password}}" 
            bindinput="onPasswordInput" 
          />
          <!-- 眼睛图标：点击切换密码显示状态 -->
          <text class="eye-icon" bindtap="togglePassword">{{showPassword ? '🙈' : '👁️'}}</text>
        </view>
      </view>
      
      <!-- 验证码输入框：只有选择短信登录时显示 -->
      <view class="form-item" wx:if="{{loginType === 'sms'}}">
        <view class="label-row">
          <text class="label">验证码</text>
          <!-- 获取验证码按钮：disabled控制是否可点击 -->
          <text 
            class="send-code" 
            bindtap="sendSmsCode" 
            disabled="{{smsDisabled}}"
          >
            {{smsButtonText}}
          </text>
        </view>
        <view class="input-wrapper">
          <text class="icon">📱</text>
          <!-- 验证码输入框：限制6位数字 -->
          <input 
            class="input" 
            placeholder="请输入验证码" 
            value="{{smsCode}}" 
            bindinput="onSmsCodeInput" 
            type="number" 
            maxlength="6" 
          />
        </view>
      </view>
      
      <!-- 登录按钮：点击触发onLogin函数 -->
      <button class="login-btn" bindtap="onLogin">登录</button>
      
      <!-- 注册链接 -->
      <view class="register-row">
        <text class="register-text">还没有账号？</text>
        <!-- 立即注册链接：点击跳转到注册页面 -->
        <text class="register-link" bindtap="goToRegister">立即注册</text>
      </view>
      
      <!-- 第三方登录分隔线 -->
      <view class="divider">
        <view class="divider-line"></view>
        <text class="divider-text">第三方登录</text>
        <view class="divider-line"></view>
      </view>
      
      <!-- 第三方登录图标 -->
      <view class="third-party">
        <!-- 微信登录：点击触发onWechatLogin函数 -->
        <view class="third-icon wechat" bindtap="onWechatLogin">
          <text>💚</text>
        </view>
        <!-- QQ登录：点击触发onQQLogin函数 -->
        <view class="third-icon qq" bindtap="onQQLogin">
          <text>💙</text>
        </view>
      </view>
      
      <!-- 协议勾选区域 -->
      <view class="agreement-section">
        <!-- 复选框：点击切换agreed状态 -->
        <view class="checkbox" bindtap="toggleAgreement">
          <view 
            class="checkbox-inner" 
            style="border-color: {{agreed ? '#FF8C00' : '#ccc'}}; background-color: {{agreed ? '#FF8C00' : 'transparent'}}"
          >
            <!-- 勾选标记：只有agreed为true时显示 -->
            <text wx:if="{{agreed}}">✓</text>
          </view>
        </view>
        <text class="agreement-text">我已阅读并同意</text>
        <text class="agreement-link">用户协议</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link">隐私政策</text>
      </view>
    </view>
  </view>
</view>